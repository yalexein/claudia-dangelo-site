---
import "../styles/editor-panel.css";

type SelectOption = {
  label: string;
  value: string;
};

type PageNavItem = {
  label: string;
  path: string;
};

type PageControl = {
  key: string;
  type: "range" | "color" | "select" | "toggle";
  label: string;
  default: string | number | boolean;
  cssVar?: string;
  min?: number;
  max?: number;
  step?: number;
  unit?: string;
  options?: SelectOption[];
  storageKey?: string;
  wide?: boolean;
};

type ContentBounds = {
  minX?: number;
  maxX?: number;
  minY?: number;
  maxY?: number;
  minRotate?: number;
  maxRotate?: number;
  minW?: number;
  maxW?: number;
};

type ContentBlockStyle = {
  fontFamily?: string;
  fontSize?: number;
  lineHeight?: number;
  letterSpacing?: number;
  wordSpacing?: number;
  textAlign?: "left" | "center" | "right" | "justify";
  fontWeight?: string;
  fontStyle?: string;
  color?: string;
};

type ContentBlockDefinition = {
  id: string;
  label?: string;
  selector: string;
  defaultText: string;
  editable?: boolean;
  transform?: "none" | "xy" | "xy-rotate";
  desktopOnlyTransform?: boolean;
  bounds?: ContentBounds;
  styleEditable?: boolean;
  deletable?: boolean;
  resizable?: boolean;
  defaultWidth?: number;
  defaultZ?: number;
  defaultStyle?: Partial<ContentBlockStyle>;
};

const fontOptions = [
  {
    label: "Proxima Nova / Avenir",
    value:
      '"Proxima Nova", "proxima-nova", "Avenir Next", Avenir, Montserrat, "Helvetica Neue", Arial, sans-serif',
  },
  {
    label: "Inter",
    value: 'Inter, "SF Pro Text", "Helvetica Neue", Arial, sans-serif',
  },
  {
    label: "Montserrat",
    value: 'Montserrat, "Proxima Nova", "Avenir Next", "Helvetica Neue", Arial, sans-serif',
  },
  {
    label: "Libre Franklin",
    value: '"Libre Franklin", "Franklin Gothic Medium", "Arial Narrow", Arial, sans-serif',
  },
  {
    label: "Source Sans 3",
    value: '"Source Sans 3", "Helvetica Neue", Arial, sans-serif',
  },
  {
    label: "Avenir Next",
    value: '"Avenir Next", Avenir, Montserrat, "Helvetica Neue", Arial, sans-serif',
  },
  {
    label: "Futura",
    value: 'Futura, "Trebuchet MS", Montserrat, Arial, sans-serif',
  },
  {
    label: "Gill Sans",
    value: '"Gill Sans", "Gill Sans MT", "Source Sans 3", Calibri, sans-serif',
  },
  {
    label: "Optima",
    value: 'Optima, Candara, "Noto Sans", sans-serif',
  },
  {
    label: "Baskerville",
    value:
      '"Baskerville", "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Garamond, Georgia, serif',
  },
  {
    label: "Didot",
    value: '"Didot", "Bodoni 72", "Bodoni MT", "Times New Roman", serif',
  },
  {
    label: "Bodoni Moda",
    value: '"Bodoni Moda", "Bodoni 72", Didot, "Times New Roman", serif',
  },
  {
    label: "Garamond",
    value: '"Cormorant Garamond", "Adobe Garamond Pro", Garamond, Georgia, serif',
  },
  {
    label: "Caslon",
    value: '"Big Caslon", "Book Antiqua", "Palatino Linotype", serif',
  },
  {
    label: "Hoefler Text",
    value: '"Hoefler Text", "Iowan Old Style", Georgia, serif',
  },
  {
    label: "Libre Baskerville",
    value: '"Libre Baskerville", Baskerville, Georgia, serif',
  },
  {
    label: "Lora",
    value: 'Lora, Georgia, "Times New Roman", serif',
  },
  {
    label: "Merriweather",
    value: 'Merriweather, Georgia, "Times New Roman", serif',
  },
  {
    label: "Playfair Display",
    value: '"Playfair Display", Didot, "Bodoni 72", Georgia, serif',
  },
  {
    label: "Spectral",
    value: 'Spectral, Georgia, "Times New Roman", serif',
  },
  {
    label: "Source Serif 4",
    value: '"Source Serif 4", Georgia, "Times New Roman", serif',
  },
  {
    label: "Times New Roman",
    value: '"Times New Roman", Times, serif',
  },
  {
    label: "Georgia",
    value: 'Georgia, "Times New Roman", serif',
  },
  {
    label: "Cormorant",
    value: '"Cormorant Infant", "Cormorant Garamond", Georgia, serif',
  },
  {
    label: "Fira Mono",
    value: '"Fira Mono", "IBM Plex Mono", ui-monospace, "SFMono-Regular", Menlo, monospace',
  },
  {
    label: "IBM Plex Mono",
    value: '"IBM Plex Mono", "Courier New", monospace',
  },
  {
    label: "PT Mono Local",
    value: '"PT Mono Local", "IBM Plex Mono", "Courier New", monospace',
  },
  {
    label: "Space Mono",
    value: '"Space Mono", "Courier New", monospace',
  },
  {
    label: "Comic Neue",
    value: '"Comic Neue", "Comic Sans MS", cursive',
  },
  {
    label: "Bradley Hand Local",
    value: '"Bradley Hand Local", "Comic Neue", "Comic Sans MS", cursive',
  },
  {
    label: "Patrick Hand",
    value: '"Patrick Hand", "Comic Sans MS", cursive',
  },
];

const miniFontOptions = fontOptions.map((option) => ({
  label: option.label,
  value: option.value,
}));

const defaultPresets = {
  background: "#fffdfb",
  background2: "#f5efe8",
  background3: "#ffe4e8",
  backgroundMode: "solid",
  backgroundAngle: 90,
  text: "#1f1a17",
  text2: "#6d4a42",
  text3: "#ef4b5b",
  textMode: "solid",
  textAngle: 90,
  accent: "#ef4b5b",
  font:
    '"Baskerville", "Iowan Old Style", "Palatino Linotype", "Book Antiqua", Garamond, Georgia, serif',
  titleFont: '"Didot", "Bodoni 72", "Bodoni MT", "Times New Roman", serif',
  fontSize: 23,
  lineHeight: 1.47,
  letterSpacing: -0.012,
  wordSpacing: 0,
  copyWidth: 72,
  align: "left",
  x: 0,
  y: 0,
};

const {
  panelTitle = "Style editor",
  storageNamespace = "bio",
  presets = {},
  pageControls = [],
  pageDefaults = {},
  pageSectionTitle = "Impostazioni pagina",
  contentSchema = [],
  contentStorageNamespace = storageNamespace,
  contentSectionTitle = "Contenuti",
  pagesNav = [],
  autoSave = true,
} = Astro.props as {
  panelTitle?: string;
  storageNamespace?: string;
  presets?: Record<string, string | number>;
  pageControls?: PageControl[];
  pageDefaults?: Record<string, string | number | boolean>;
  pageSectionTitle?: string;
  contentSchema?: ContentBlockDefinition[];
  contentStorageNamespace?: string;
  contentSectionTitle?: string;
  pagesNav?: PageNavItem[];
  autoSave?: boolean;
};

const mergedPresets = { ...defaultPresets, ...presets };

const normalizedPageControls = pageControls.map((control) => {
  const fallbackDefault = pageDefaults[control.key] ?? control.default;
  return { ...control, default: fallbackDefault };
});

const pageDefaultMap = Object.fromEntries(
  normalizedPageControls.map((control) => [control.key, control.default]),
);

const mergedDefaults = { ...mergedPresets, ...pageDefaultMap };

const pageControlMeta = normalizedPageControls.map((control) => ({
  key: control.key,
  type: control.type,
  unit: control.unit ?? "",
  cssVar: control.cssVar ?? "",
  storageKey: control.storageKey ?? "",
  fallback: control.default,
}));

const normalizeContentStyle = (rawStyle?: Partial<ContentBlockStyle>) => {
  if (!rawStyle || typeof rawStyle !== "object") return {};
  const normalized: Partial<ContentBlockStyle> = {};

  if (typeof rawStyle.fontFamily === "string" && rawStyle.fontFamily.trim()) normalized.fontFamily = rawStyle.fontFamily;
  if (typeof rawStyle.fontSize === "number" && Number.isFinite(rawStyle.fontSize)) normalized.fontSize = rawStyle.fontSize;
  if (typeof rawStyle.lineHeight === "number" && Number.isFinite(rawStyle.lineHeight)) normalized.lineHeight = rawStyle.lineHeight;
  if (typeof rawStyle.letterSpacing === "number" && Number.isFinite(rawStyle.letterSpacing))
    normalized.letterSpacing = rawStyle.letterSpacing;
  if (typeof rawStyle.wordSpacing === "number" && Number.isFinite(rawStyle.wordSpacing)) normalized.wordSpacing = rawStyle.wordSpacing;
  if (typeof rawStyle.textAlign === "string" && rawStyle.textAlign.trim()) normalized.textAlign = rawStyle.textAlign as ContentBlockStyle["textAlign"];
  if (typeof rawStyle.fontWeight === "string" && rawStyle.fontWeight.trim()) normalized.fontWeight = rawStyle.fontWeight;
  if (typeof rawStyle.fontStyle === "string" && rawStyle.fontStyle.trim()) normalized.fontStyle = rawStyle.fontStyle;
  if (typeof rawStyle.color === "string" && rawStyle.color.trim()) normalized.color = rawStyle.color;

  return normalized;
};

const toNumber = (value: unknown, fallback = 0) => {
  const parsed = Number(value);
  return Number.isFinite(parsed) ? parsed : fallback;
};

const normalizedContentSchema = contentSchema.map((block) => ({
  id: block.id,
  label: block.label ?? block.id,
  selector: block.selector,
  defaultText: block.defaultText,
  editable: block.editable !== false,
  transform: block.transform ?? "none",
  desktopOnlyTransform: Boolean(block.desktopOnlyTransform),
  bounds: block.bounds ?? {},
  styleEditable: block.styleEditable !== false,
  deletable: Boolean(block.deletable),
  resizable: Boolean(block.resizable),
  defaultWidth: toNumber(block.defaultWidth, 0),
  defaultStyle: normalizeContentStyle(block.defaultStyle),
}));

const toBoolean = (value: unknown) =>
  value === true || value === 1 || value === "1" || value === "true" || value === "on";

const formatControlValue = (control: PageControl) => {
  if (control.type === "toggle") {
    return toBoolean(control.default) ? "On" : "Off";
  }

  if (control.unit) {
    return `${control.default}${control.unit}`;
  }

  return `${control.default}`;
};

const storageKey = `claudia-editor-${storageNamespace}-settings`;
const panelStateKey = `claudia-editor-${storageNamespace}-panel-open`;
const panelPosKey = `claudia-editor-${storageNamespace}-panel-pos-v1`;
const contentNamespace = contentStorageNamespace || storageNamespace;
const contentStorageKey = `claudia-content-${contentNamespace}-v1`;
const base = import.meta.env.BASE_URL;

const normalizedPagesNav = (Array.isArray(pagesNav) ? pagesNav : [])
  .filter((item) => item && typeof item === "object")
  .map((item) => ({
    label: String(item.label || "").trim(),
    path: String(item.path || "").trim(),
  }))
  .filter((item) => item.label && item.path);

const buildHref = (path: string) => `${base}${path.replace(/^\//, "")}`;
---

<aside
  class="style-editor-panel"
  data-style-editor
  data-storage-key={storageKey}
  data-panel-key={panelStateKey}
  data-panel-pos-key={panelPosKey}
  data-content-storage-key={contentStorageKey}
  data-content-namespace={contentNamespace}
>
  <div class="style-editor-panel__topbar" data-style-drag-surface>
    <h2>{panelTitle}</h2>

    <div class="style-editor-top-actions">
      <button class="style-editor-drag" type="button" aria-label="Sposta pannello editor" data-style-drag title="Sposta">
        ⇳
      </button>
      {normalizedPagesNav.length > 0 && (
        <details class="style-editor-pages" data-style-pages>
          <summary class="style-editor-pages__summary">Pagine</summary>
          <nav class="style-editor-pages__menu" aria-label="Vai a pagina">
            {normalizedPagesNav.map((item) => (
              <a class="style-editor-pages__link" href={buildHref(item.path)}>
                {item.label}
              </a>
            ))}
          </nav>
        </details>
      )}

      <button class="style-editor-collapse" type="button" data-style-collapse aria-expanded="true">
        Nascondi
      </button>
    </div>
  </div>

  <div class="style-editor-panel__content">
    <div class="style-editor-grid">
      <div class="style-editor-field">
        <label for={`editor-bg-mode-${storageNamespace}`}>Sfondo</label>
        <select id={`editor-bg-mode-${storageNamespace}`} data-style-control="backgroundMode">
          <option value="solid" selected={mergedPresets.backgroundMode === "solid"}>Solido</option>
          <option value="linear-2" selected={mergedPresets.backgroundMode === "linear-2"}>Lineare 2</option>
          <option value="linear-3" selected={mergedPresets.backgroundMode === "linear-3"}>Lineare 3</option>
          <option value="radial-2" selected={mergedPresets.backgroundMode === "radial-2"}>Radiale 2</option>
          <option value="radial-3" selected={mergedPresets.backgroundMode === "radial-3"}>Radiale 3</option>
          <option value="grain" selected={mergedPresets.backgroundMode === "grain"}>Granulato</option>
        </select>
      </div>

      <div class="style-editor-field">
        <label for={`editor-text-mode-${storageNamespace}`}>Testo</label>
        <select id={`editor-text-mode-${storageNamespace}`} data-style-control="textMode">
          <option value="solid" selected={mergedPresets.textMode === "solid"}>Solido</option>
          <option value="linear-2" selected={mergedPresets.textMode === "linear-2"}>Lineare 2</option>
          <option value="linear-3" selected={mergedPresets.textMode === "linear-3"}>Lineare 3</option>
          <option value="radial-2" selected={mergedPresets.textMode === "radial-2"}>Radiale 2</option>
          <option value="radial-3" selected={mergedPresets.textMode === "radial-3"}>Radiale 3</option>
        </select>
      </div>

      <div class="style-editor-field">
        <label for={`editor-bg-1-${storageNamespace}`}>Sfondo (primario)</label>
        <input
          id={`editor-bg-1-${storageNamespace}`}
          type="color"
          value={mergedPresets.background}
          data-style-control="background"
        />
      </div>

      <div class="style-editor-field">
        <label for={`editor-text-1-${storageNamespace}`}>Testo (primario)</label>
        <input
          id={`editor-text-1-${storageNamespace}`}
          type="color"
          value={mergedPresets.text}
          data-style-control="text"
        />
      </div>

      <div class="style-editor-field">
        <label for={`editor-bg-2-${storageNamespace}`}>Sfondo (secondario)</label>
        <input
          id={`editor-bg-2-${storageNamespace}`}
          type="color"
          value={mergedPresets.background2}
          data-style-control="background2"
        />
      </div>

      <div class="style-editor-field">
        <label for={`editor-text-2-${storageNamespace}`}>Testo (secondario)</label>
        <input id={`editor-text-2-${storageNamespace}`} type="color" value={mergedPresets.text2} data-style-control="text2" />
      </div>

      <div class="style-editor-field">
        <label for={`editor-bg-3-${storageNamespace}`}>Sfondo (terziario)</label>
        <input
          id={`editor-bg-3-${storageNamespace}`}
          type="color"
          value={mergedPresets.background3}
          data-style-control="background3"
        />
      </div>

      <div class="style-editor-field">
        <label for={`editor-text-3-${storageNamespace}`}>Testo (terziario)</label>
        <input id={`editor-text-3-${storageNamespace}`} type="color" value={mergedPresets.text3} data-style-control="text3" />
      </div>

      <div class="style-editor-field">
        <label for={`editor-accent-${storageNamespace}`}>Accento</label>
        <input id={`editor-accent-${storageNamespace}`} type="color" value={mergedPresets.accent} data-style-control="accent" />
      </div>

      <div class="style-editor-field">
        <label for={`editor-align-${storageNamespace}`}>Allineamento</label>
        <select id={`editor-align-${storageNamespace}`} data-style-control="align">
          <option value="left" selected={mergedPresets.align === "left"}>Sinistra</option>
          <option value="center" selected={mergedPresets.align === "center"}>Centro</option>
          <option value="right" selected={mergedPresets.align === "right"}>Destra</option>
          <option value="justify" selected={mergedPresets.align === "justify"}>Giustificato</option>
        </select>
      </div>

      <div class="style-editor-field">
        <label for={`editor-bg-angle-${storageNamespace}`}>Angolo sfondo</label>
        <input
          id={`editor-bg-angle-${storageNamespace}`}
          type="range"
          min="0"
          max="360"
          step="1"
          value={mergedPresets.backgroundAngle}
          data-style-control="backgroundAngle"
        />
        <span class="style-editor-range-value" data-style-value="backgroundAngle">{mergedPresets.backgroundAngle}°</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-text-angle-${storageNamespace}`}>Angolo testo</label>
        <input
          id={`editor-text-angle-${storageNamespace}`}
          type="range"
          min="0"
          max="360"
          step="1"
          value={mergedPresets.textAngle}
          data-style-control="textAngle"
        />
        <span class="style-editor-range-value" data-style-value="textAngle">{mergedPresets.textAngle}°</span>
      </div>

      <div class="style-editor-field style-editor-field--wide">
        <label for={`editor-font-${storageNamespace}`}>Font</label>
        <select id={`editor-font-${storageNamespace}`} data-style-control="font">
          {fontOptions.map((option) => (
            <option value={option.value} selected={mergedPresets.font === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      </div>

      <div class="style-editor-field style-editor-field--wide">
        <label for={`editor-title-font-${storageNamespace}`}>Font titolo</label>
        <select id={`editor-title-font-${storageNamespace}`} data-style-control="titleFont">
          {fontOptions.map((option) => (
            <option value={option.value} selected={mergedPresets.titleFont === option.value}>
              {option.label}
            </option>
          ))}
        </select>
      </div>

      <div class="style-editor-field">
        <label for={`editor-font-size-${storageNamespace}`}>Font size</label>
        <input
          id={`editor-font-size-${storageNamespace}`}
          type="range"
          min="12"
          max="64"
          step="1"
          value={mergedPresets.fontSize}
          data-style-control="fontSize"
        />
        <span class="style-editor-range-value" data-style-value="fontSize">{mergedPresets.fontSize}px</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-line-height-${storageNamespace}`}>Interlinea</label>
        <input
          id={`editor-line-height-${storageNamespace}`}
          type="range"
          min="0.8"
          max="3"
          step="0.01"
          value={mergedPresets.lineHeight}
          data-style-control="lineHeight"
        />
        <span class="style-editor-range-value" data-style-value="lineHeight">{mergedPresets.lineHeight}</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-letter-spacing-${storageNamespace}`}>Tracking</label>
        <input
          id={`editor-letter-spacing-${storageNamespace}`}
          type="range"
          min="-0.08"
          max="0.18"
          step="0.001"
          value={mergedPresets.letterSpacing}
          data-style-control="letterSpacing"
        />
        <span class="style-editor-range-value" data-style-value="letterSpacing">{mergedPresets.letterSpacing}em</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-word-spacing-${storageNamespace}`}>Spazio parole</label>
        <input
          id={`editor-word-spacing-${storageNamespace}`}
          type="range"
          min="-0.2"
          max="0.8"
          step="0.005"
          value={mergedPresets.wordSpacing}
          data-style-control="wordSpacing"
        />
        <span class="style-editor-range-value" data-style-value="wordSpacing">{mergedPresets.wordSpacing}em</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-copy-width-${storageNamespace}`}>Larghezza testo</label>
        <input
          id={`editor-copy-width-${storageNamespace}`}
          type="range"
          min="20"
          max="190"
          step="1"
          value={mergedPresets.copyWidth}
          data-style-control="copyWidth"
        />
        <span class="style-editor-range-value" data-style-value="copyWidth">{mergedPresets.copyWidth}ch</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-x-${storageNamespace}`}>Posizione X</label>
        <input id={`editor-x-${storageNamespace}`} type="range" min="-700" max="700" step="2" value={mergedPresets.x} data-style-control="x" />
        <span class="style-editor-range-value" data-style-value="x">{mergedPresets.x}px</span>
      </div>

      <div class="style-editor-field">
        <label for={`editor-y-${storageNamespace}`}>Posizione Y</label>
        <input id={`editor-y-${storageNamespace}`} type="range" min="-320" max="320" step="2" value={mergedPresets.y} data-style-control="y" />
        <span class="style-editor-range-value" data-style-value="y">{mergedPresets.y}px</span>
      </div>

      {normalizedPageControls.length > 0 && (
        <>
          <div class="style-editor-divider" aria-hidden="true"></div>
          <h3 class="style-editor-subtitle">{pageSectionTitle}</h3>

          {normalizedPageControls.map((control) => (
            <div class:list={["style-editor-field", control.wide && "style-editor-field--wide"]}>
              <label for={`editor-page-${control.key}-${storageNamespace}`}>{control.label}</label>

              {control.type === "color" && (
                <input
                  id={`editor-page-${control.key}-${storageNamespace}`}
                  type="color"
                  value={String(control.default)}
                  data-style-control={control.key}
                  data-style-type={control.type}
                  data-style-css-var={control.cssVar ?? ""}
                  data-style-unit={control.unit ?? ""}
                  data-style-storage-key={control.storageKey ?? ""}
                />
              )}

              {control.type === "range" && (
                <>
                  <input
                    id={`editor-page-${control.key}-${storageNamespace}`}
                    type="range"
                    min={control.min}
                    max={control.max}
                    step={control.step}
                    value={String(control.default)}
                    data-style-control={control.key}
                    data-style-type={control.type}
                    data-style-css-var={control.cssVar ?? ""}
                    data-style-unit={control.unit ?? ""}
                    data-style-storage-key={control.storageKey ?? ""}
                  />
                  <span class="style-editor-range-value" data-style-value={control.key}>
                    {formatControlValue(control)}
                  </span>
                </>
              )}

              {control.type === "select" && (
                <select
                  id={`editor-page-${control.key}-${storageNamespace}`}
                  data-style-control={control.key}
                  data-style-type={control.type}
                  data-style-css-var={control.cssVar ?? ""}
                  data-style-unit={control.unit ?? ""}
                  data-style-storage-key={control.storageKey ?? ""}
                >
                  {(control.options ?? []).map((option) => (
                    <option value={option.value} selected={String(control.default) === option.value}>{option.label}</option>
                  ))}
                </select>
              )}

              {control.type === "toggle" && (
                <>
                  <label class="style-editor-toggle" for={`editor-page-${control.key}-${storageNamespace}`}>
                    <input
                      id={`editor-page-${control.key}-${storageNamespace}`}
                      type="checkbox"
                      checked={toBoolean(control.default)}
                      data-style-control={control.key}
                      data-style-type={control.type}
                      data-style-css-var={control.cssVar ?? ""}
                      data-style-unit={control.unit ?? ""}
                      data-style-storage-key={control.storageKey ?? ""}
                    />
                    <span>Attiva</span>
                  </label>
                  <span class="style-editor-range-value" data-style-value={control.key}>
                    {formatControlValue(control)}
                  </span>
                </>
              )}
            </div>
          ))}
        </>
      )}

      <div class="style-editor-divider" aria-hidden="true"></div>
      <h3 class="style-editor-subtitle">Presets</h3>

      <div class="style-editor-field style-editor-field--wide">
        <label for={`editor-preset-slot-${storageNamespace}`}>Slot preset</label>
        <select id={`editor-preset-slot-${storageNamespace}`} data-style-preset-slot>
          {Array.from({ length: 10 }, (_, index) => (
            <option value={`${index + 1}`}>Slot {index + 1}</option>
          ))}
        </select>
      </div>

      <div class="style-editor-field style-editor-field--wide">
        <div class="style-editor-content-actions style-editor-content-actions--compact">
          <button type="button" data-style-preset-save>Salva preset</button>
          <button type="button" data-style-preset-load>Carica preset</button>
          <button type="button" data-style-randomize>Randomizza</button>
        </div>
      </div>
    </div>

    <div class="style-editor-actions">
      <button class="style-editor-save" type="button" data-style-save>Salva</button>
      <button class="style-editor-reset" type="button" data-style-reset>Reset</button>
    </div>
    <p class="style-editor-status" data-style-status aria-live="polite"></p>

    <slot name="extra" />

    {normalizedContentSchema.length > 0 && (
      <div class="style-editor-content">
        <div class="style-editor-divider" aria-hidden="true"></div>
        <h3 class="style-editor-subtitle">{contentSectionTitle}</h3>

        <div class="style-editor-grid">
          <div class="style-editor-field style-editor-field--wide">
            <label class="style-editor-toggle" for={`editor-content-mode-${storageNamespace}`}>
              <input id={`editor-content-mode-${storageNamespace}`} type="checkbox" data-content-edit-mode />
              <span>Edit mode</span>
            </label>
          </div>

          <details class="style-editor-advanced style-editor-field--wide style-editor-snap-settings" open>
            <summary>Snap e griglia</summary>
            <div class="style-editor-grid style-editor-grid--snap">
              <div class="style-editor-field">
                <label class="style-editor-toggle" for={`editor-snap-enabled-${storageNamespace}`}>
                  <input id={`editor-snap-enabled-${storageNamespace}`} type="checkbox" data-editor-snap-enabled />
                  <span>Snap attivo</span>
                </label>
              </div>

              <div class="style-editor-field">
                <label class="style-editor-toggle" for={`editor-snap-grid-${storageNamespace}`}>
                  <input id={`editor-snap-grid-${storageNamespace}`} type="checkbox" data-editor-snap-grid />
                  <span>Mostra griglia</span>
                </label>
              </div>

              <div class="style-editor-field style-editor-field--wide">
                <label for={`editor-snap-size-${storageNamespace}`}>Passo griglia</label>
                <input
                  id={`editor-snap-size-${storageNamespace}`}
                  type="range"
                  min="4"
                  max="160"
                  step="1"
                  data-editor-snap-size
                />
                <span class="style-editor-range-value" data-editor-snap-value>20px</span>
              </div>

              <p class="style-editor-context-note style-editor-field--wide">
                Tieni premuto Alt mentre trascini per ignorare lo snap al volo.
              </p>
            </div>
          </details>

          <div class="style-editor-field style-editor-field--wide">
            <label for={`editor-content-block-${storageNamespace}`}>Blocco testo</label>
            <select id={`editor-content-block-${storageNamespace}`} data-content-block-select>
              {normalizedContentSchema.map((block) => (
                <option value={block.id}>{block.label}</option>
              ))}
            </select>
            <p class="style-editor-context-note" data-content-active-label>Stai modificando: —</p>
          </div>

          <div class="style-editor-field style-editor-field--wide">
            <label for={`editor-content-text-${storageNamespace}`}>Testo</label>
            <textarea id={`editor-content-text-${storageNamespace}`} rows={6} data-content-text></textarea>
          </div>

          <details class="style-editor-advanced style-editor-field--wide" data-content-style-advanced>
            <summary>Tipografia box (Advanced)</summary>
            <p class="style-editor-context-note style-editor-context-note--compact" data-content-style-scope>
              Le impostazioni qui sotto si applicano solo al box selezionato.
            </p>
            <div class="style-editor-grid style-editor-grid--content-style">
              <div class="style-editor-field style-editor-field--wide">
                <label for={`editor-content-style-font-${storageNamespace}`}>Font box</label>
                <select id={`editor-content-style-font-${storageNamespace}`} data-content-style-font>
                  {fontOptions.map((option) => (
                    <option value={option.value}>{option.label}</option>
                  ))}
                </select>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-size-${storageNamespace}`}>Font size</label>
                <input
                  id={`editor-content-style-size-${storageNamespace}`}
                  type="range"
                  min="10"
                  max="96"
                  step="0.1"
                  data-content-style-size
                />
                <span class="style-editor-range-value" data-content-style-value="fontSize">0px</span>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-line-height-${storageNamespace}`}>Interlinea</label>
                <input
                  id={`editor-content-style-line-height-${storageNamespace}`}
                  type="range"
                  min="0.8"
                  max="3"
                  step="0.01"
                  data-content-style-line-height
                />
                <span class="style-editor-range-value" data-content-style-value="lineHeight">0</span>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-letter-spacing-${storageNamespace}`}>Tracking</label>
                <input
                  id={`editor-content-style-letter-spacing-${storageNamespace}`}
                  type="range"
                  min="-0.1"
                  max="0.3"
                  step="0.001"
                  data-content-style-letter-spacing
                />
                <span class="style-editor-range-value" data-content-style-value="letterSpacing">0em</span>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-word-spacing-${storageNamespace}`}>Spazio parole</label>
                <input
                  id={`editor-content-style-word-spacing-${storageNamespace}`}
                  type="range"
                  min="-0.2"
                  max="1"
                  step="0.005"
                  data-content-style-word-spacing
                />
                <span class="style-editor-range-value" data-content-style-value="wordSpacing">0em</span>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-align-${storageNamespace}`}>Allineamento</label>
                <select id={`editor-content-style-align-${storageNamespace}`} data-content-style-align>
                  <option value="left">Sinistra</option>
                  <option value="center">Centro</option>
                  <option value="right">Destra</option>
                  <option value="justify">Giustificato</option>
                </select>
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-color-${storageNamespace}`}>Colore testo</label>
                <input id={`editor-content-style-color-${storageNamespace}`} type="color" data-content-style-color />
              </div>

              <div class="style-editor-field">
                <label for={`editor-content-style-z-${storageNamespace}`}>Livello</label>
                <input
                  id={`editor-content-style-z-${storageNamespace}`}
                  type="range"
                  min="0"
                  max="200"
                  step="1"
                  data-content-style-z
                />
                <span class="style-editor-range-value" data-content-style-value="z">30</span>
              </div>

              <div class="style-editor-field">
                <label class="style-editor-toggle" for={`editor-content-style-bold-${storageNamespace}`}>
                  <input id={`editor-content-style-bold-${storageNamespace}`} type="checkbox" data-content-style-bold />
                  <span>Grassetto</span>
                </label>
              </div>

              <div class="style-editor-field">
                <label class="style-editor-toggle" for={`editor-content-style-italic-${storageNamespace}`}>
                  <input id={`editor-content-style-italic-${storageNamespace}`} type="checkbox" data-content-style-italic />
                  <span>Corsivo</span>
                </label>
              </div>
            </div>
          </details>

        <div class="style-editor-transform-grid" data-content-transform-controls>
          <div class="style-editor-field">
            <label for={`editor-content-x-${storageNamespace}`}>Posizione X</label>
            <input id={`editor-content-x-${storageNamespace}`} type="range" data-content-x />
            <span class="style-editor-range-value" data-content-value="x">0px</span>
          </div>

          <div class="style-editor-field">
            <label for={`editor-content-y-${storageNamespace}`}>Posizione Y</label>
            <input id={`editor-content-y-${storageNamespace}`} type="range" data-content-y />
            <span class="style-editor-range-value" data-content-value="y">0px</span>
          </div>

          <div class="style-editor-field">
            <label for={`editor-content-rotate-${storageNamespace}`}>Rotazione</label>
            <input id={`editor-content-rotate-${storageNamespace}`} type="range" data-content-rotate />
            <span class="style-editor-range-value" data-content-value="rotate">0°</span>
          </div>

          <div class="style-editor-field">
            <label for={`editor-content-width-${storageNamespace}`}>Larghezza (px)</label>
            <input id={`editor-content-width-${storageNamespace}`} type="range" min="180" max="1200" value="0" data-content-width />
            <span class="style-editor-range-value" data-content-value="w">0px</span>
          </div>
        </div>
      </div>

        <div class="style-editor-content-actions">
          <button type="button" data-content-add-rich>Aggiungi rich text box</button>
          <button type="button" data-content-save>Salva contenuti</button>
          <button type="button" data-content-reset>Reset contenuti</button>
          <button type="button" data-content-show-all>Ripristina blocchi</button>
          <button type="button" data-content-reset-style-block>Reset stile blocco</button>
          <button type="button" data-content-reset-style-all>Reset tutti stili</button>
          <button type="button" data-content-export>Export JSON</button>
          <button type="button" data-content-import>Import JSON</button>
          <input type="file" accept=".json,application/json" hidden data-content-import-file />
        </div>
        <p class="style-editor-status style-editor-status--content" data-content-status aria-live="polite"></p>
      </div>
    )}
  </div>
</aside>

<script define:vars={{ mergedPresets, mergedDefaults, pageControlMeta, autoSave }}>
  const globalNumericKeys = new Set([
    "fontSize",
    "lineHeight",
    "letterSpacing",
    "wordSpacing",
    "copyWidth",
    "x",
    "y",
    "backgroundAngle",
    "textAngle",
  ]);

  const pageMetaByKey = new Map((pageControlMeta ?? []).map((item) => [item.key, item]));
  const pageNumericKeys = new Set(
    (pageControlMeta ?? []).filter((item) => item.type === "range").map((item) => item.key),
  );
  const pageBooleanKeys = new Set(
    (pageControlMeta ?? []).filter((item) => item.type === "toggle").map((item) => item.key),
  );

  const buildGradientValue = (mode, color1, color2, color3, angle) => {
    if (mode === "linear-2") return `linear-gradient(${angle}deg, ${color1}, ${color2})`;
    if (mode === "linear-3") return `linear-gradient(${angle}deg, ${color1}, ${color2}, ${color3})`;
    if (mode === "radial-2") return `radial-gradient(circle at center, ${color1}, ${color2})`;
    if (mode === "radial-3") return `radial-gradient(circle at center, ${color1}, ${color2}, ${color3})`;
    if (mode === "grain") {
      return [
        `radial-gradient(circle at 18% 24%, color-mix(in srgb, ${color2} 52%, transparent) 0 1px, transparent 1.7px)`,
        `radial-gradient(circle at 72% 36%, color-mix(in srgb, ${color3} 38%, transparent) 0 1px, transparent 1.9px)`,
        `radial-gradient(circle at 42% 78%, color-mix(in srgb, #000000 10%, transparent) 0 0.8px, transparent 1.6px)`,
        `linear-gradient(${color1}, ${color1})`,
      ].join(", ");
    }
    return color1;
  };

    const toBoolean = (value) =>
      value === true || value === 1 || value === "1" || value === "true" || value === "on";

  const randomBetween = (min, max, precision = 0) => {
    const value = min + Math.random() * (max - min);
    return precision > 0 ? Number(value.toFixed(precision)) : Math.round(value);
  };

  const randomChoice = (items) => items[Math.floor(Math.random() * items.length)];

  const hueToHex = (hue, saturation = 48, lightness = 72) => {
    const normalizedHue = ((hue % 360) + 360) % 360;
    const s = saturation / 100;
    const l = lightness / 100;
    const chroma = (1 - Math.abs(2 * l - 1)) * s;
    const x = chroma * (1 - Math.abs(((normalizedHue / 60) % 2) - 1));
    const m = l - chroma / 2;
    const [r1, g1, b1] =
      normalizedHue < 60
        ? [chroma, x, 0]
        : normalizedHue < 120
          ? [x, chroma, 0]
          : normalizedHue < 180
            ? [0, chroma, x]
            : normalizedHue < 240
              ? [0, x, chroma]
              : normalizedHue < 300
                ? [x, 0, chroma]
                : [chroma, 0, x];
    return [r1, g1, b1]
      .map((channel) => Math.round((channel + m) * 255).toString(16).padStart(2, "0"))
      .join("");
  };

  const initContentEditors = () => {
    document.querySelectorAll("[data-style-editor]").forEach((panel) => {
    if (!(panel instanceof HTMLElement) || panel.dataset.styleEditorBound === "true") return;
    panel.dataset.styleEditorBound = "true";

    const storageKey = panel.dataset.storageKey ?? "";
    const panelKey = panel.dataset.panelKey ?? "";
    const panelPosKey = panel.dataset.panelPosKey ?? "";
    const controls = panel.querySelectorAll("[data-style-control]");
    const valueNodes = panel.querySelectorAll("[data-style-value]");
    const resetButton = panel.querySelector("[data-style-reset]");
    const saveButton = panel.querySelector("[data-style-save]");
    const collapseButton = panel.querySelector("[data-style-collapse]");
    const dragButton = panel.querySelector("[data-style-drag]");
    const dragSurface = panel.querySelector("[data-style-drag-surface]");
    const statusNode = panel.querySelector("[data-style-status]");
    const presetSelect = panel.querySelector("[data-style-preset-slot]");
    const presetSaveButton = panel.querySelector("[data-style-preset-save]");
    const presetLoadButton = panel.querySelector("[data-style-preset-load]");
    const randomizeButton = panel.querySelector("[data-style-randomize]");
    const root = document.documentElement;
    const presetStorageKey = `${storageKey}-presets-v1`;
    let statusTimerId = 0;

    const state = { ...mergedDefaults };
    const autoSaveEnabled = Boolean(autoSave);
    let autoSaveTimerId = 0;

    const scheduleAutoSave = () => {
      if (!autoSaveEnabled) return;
      window.clearTimeout(autoSaveTimerId);
      autoSaveTimerId = window.setTimeout(() => {
        try {
          persistState(false);
          window.dispatchEvent(
            new CustomEvent("style-editor:save-all", {
              detail: { storageKey },
            }),
          );
        } catch {}
      }, 700);
    };

    const setStatus = (message) => {
      if (!(statusNode instanceof HTMLElement)) return;
      statusNode.textContent = message;
      window.clearTimeout(statusTimerId);
      if (!message) return;
      statusTimerId = window.setTimeout(() => {
        if (statusNode instanceof HTMLElement) statusNode.textContent = "";
      }, 2200);
    };

    const setPanelOpen = (isOpen) => {
      panel.classList.toggle("is-collapsed", !isOpen);
      if (collapseButton instanceof HTMLButtonElement) {
        collapseButton.textContent = isOpen ? "Nascondi" : "Apri";
        collapseButton.setAttribute("aria-expanded", isOpen ? "true" : "false");
      }

      try {
        if (panelKey) window.localStorage.setItem(panelKey, isOpen ? "open" : "closed");
      } catch (error) {
        console.warn("Impossibile salvare lo stato del pannello.", error);
      }

      window.requestAnimationFrame(() => {
        clampCurrentPanelPos(true);
      });
    };

    const applyStateToCss = () => {
      const backgroundFill = buildGradientValue(
        state.backgroundMode,
        state.background,
        state.background2,
        state.background3,
        state.backgroundAngle,
      );

      const textFill = buildGradientValue(
        state.textMode,
        state.text,
        state.text2,
        state.text3,
        state.textAngle,
      );

      root.style.setProperty("--editor-bg-1", state.background);
      root.style.setProperty("--editor-bg-2", state.background2);
      root.style.setProperty("--editor-bg-3", state.background3);
      root.style.setProperty("--editor-bg-color", state.background);
      root.style.setProperty("--editor-bg-fill", backgroundFill);
      root.style.setProperty("--editor-fg", state.text);
      root.style.setProperty("--editor-text-fill", textFill);
      root.style.setProperty("--editor-accent", state.accent);
      root.style.setProperty("--editor-font", state.font);
      root.style.setProperty("--editor-title-font", state.titleFont);
      root.style.setProperty("--editor-font-size", `${state.fontSize}px`);
      root.style.setProperty("--editor-line-height", `${state.lineHeight}`);
      root.style.setProperty("--editor-letter-spacing", `${state.letterSpacing}em`);
      root.style.setProperty("--editor-word-spacing", `${state.wordSpacing}em`);
      root.style.setProperty("--editor-copy-width", `${state.copyWidth}ch`);
      root.style.setProperty("--editor-align", state.align);
      root.style.setProperty("--editor-x", `${state.x}px`);
      root.style.setProperty("--editor-y", `${state.y}px`);

      document.body.classList.toggle("editor-has-text-gradient", state.textMode !== "solid");
      document.body.classList.toggle("editor-has-bg-gradient", state.backgroundMode !== "solid");
    };

    const applyPageCssVar = (key, value) => {
      const meta = pageMetaByKey.get(key);
      if (!meta || !meta.cssVar) return;

      if (meta.type === "toggle") {
        root.style.setProperty(meta.cssVar, value ? "1" : "0");
        return;
      }

      if (meta.type === "range" && meta.unit) {
        root.style.setProperty(meta.cssVar, `${value}${meta.unit}`);
        return;
      }

      root.style.setProperty(meta.cssVar, `${value}`);
    };

    const updateValueLabel = (key, value) => {
      valueNodes.forEach((node) => {
        if (!(node instanceof HTMLElement) || node.dataset.styleValue !== key) return;

        const pageMeta = pageMetaByKey.get(key);
        if (pageMeta) {
          if (pageMeta.type === "toggle") {
            node.textContent = value ? "On" : "Off";
            return;
          }

          if (pageMeta.unit) {
            node.textContent = `${value}${pageMeta.unit}`;
            return;
          }

          node.textContent = `${value}`;
          return;
        }

        if (key === "fontSize" || key === "x" || key === "y") {
          node.textContent = `${value}px`;
          return;
        }

        if (key === "copyWidth") {
          node.textContent = `${value}ch`;
          return;
        }

        if (key === "letterSpacing" || key === "wordSpacing") {
          node.textContent = `${value}em`;
          return;
        }

        if (key === "backgroundAngle" || key === "textAngle") {
          node.textContent = `${value}°`;
          return;
        }

        node.textContent = `${value}`;
      });
    };

    const castValue = (key, value, fallbackValue) => {
      if (pageBooleanKeys.has(key)) return toBoolean(value);

      if (globalNumericKeys.has(key) || pageNumericKeys.has(key)) {
        const parsed = Number(value);
        if (Number.isFinite(parsed)) return parsed;
        return fallbackValue;
      }

      return value;
    };

    const getControlValue = (control) => {
      if (control instanceof HTMLInputElement && control.type === "checkbox") {
        return control.checked;
      }

      return control.value;
    };

    const setControlValue = (control, value) => {
      if (control instanceof HTMLInputElement && control.type === "checkbox") {
        control.checked = toBoolean(value);
        return;
      }

      control.value = `${value}`;
    };

    const readStorage = (key) => {
      if (!key) return {};
      try {
        return JSON.parse(window.localStorage.getItem(key) ?? "{}");
      } catch (error) {
        return {};
      }
    };

    const customStorageKeys = new Set();
    controls.forEach((control) => {
      if (!(control instanceof HTMLInputElement || control instanceof HTMLSelectElement)) return;
      const customKey = control.dataset.styleStorageKey ?? "";
      if (customKey) customStorageKeys.add(customKey);
    });

    const storedPrimary = readStorage(storageKey);
    const storedByBucket = new Map();
    customStorageKeys.forEach((bucketKey) => {
      storedByBucket.set(bucketKey, readStorage(bucketKey));
    });

    const applySetting = (key, rawValue) => {
      const fallback = mergedDefaults[key] ?? mergedPresets[key] ?? rawValue;
      state[key] = castValue(key, rawValue, fallback);
      applyStateToCss();
      applyPageCssVar(key, state[key]);
      updateValueLabel(key, state[key]);
    };

    const readPanelPos = () => {
      try {
        if (!panelPosKey) return null;
        const raw = window.localStorage.getItem(panelPosKey);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== "object") return null;
        const x = Number(parsed.x);
        const y = Number(parsed.y);
        return {
          x: Number.isFinite(x) ? x : 0,
          y: Number.isFinite(y) ? y : 0,
        };
      } catch {
        return null;
      }
    };

    const readCurrentPanelPos = () => ({
      x: parsePanelNumber(getComputedStyle(panel).getPropertyValue("--editor-panel-x"), 0),
      y: parsePanelNumber(getComputedStyle(panel).getPropertyValue("--editor-panel-y"), 0),
    });

    const parsePanelNumber = (value, fallback = 0) => {
      if (typeof value === "string") {
        const match = value.trim().match(/-?\d+(\.\d+)?/);
        if (match) {
          const parsed = Number(match[0]);
          return Number.isFinite(parsed) ? parsed : fallback;
        }
        return fallback;
      }
      const parsed = Number(value);
      return Number.isFinite(parsed) ? parsed : fallback;
    };

    const clampPanelPos = (pos) => {
      const margin = 8;
      const style = getComputedStyle(panel);
      const top = parsePanelNumber(style.top, 20);
      const right = parsePanelNumber(style.right, 20);
      const width = Math.max(panel.offsetWidth, 1);
      const height = Math.max(panel.offsetHeight, 1);
      const viewportWidth = Math.max(window.innerWidth || 0, width + margin * 2);
      const viewportHeight = Math.max(window.innerHeight || 0, height + margin * 2);
      const baseLeft = viewportWidth - right - width;
      const baseTop = top;
      const desiredLeft = baseLeft + parsePanelNumber(pos?.x, 0);
      const desiredTop = baseTop + parsePanelNumber(pos?.y, 0);
      const maxLeft = Math.max(margin, viewportWidth - width - margin);
      const maxTop = Math.max(margin, viewportHeight - height - margin);
      const left = Math.min(Math.max(desiredLeft, margin), maxLeft);
      const nextTop = Math.min(Math.max(desiredTop, margin), maxTop);

      return {
        x: Math.round(left - baseLeft),
        y: Math.round(nextTop - baseTop),
      };
    };

    const applyPanelPos = (pos) => {
      if (!pos || typeof pos !== "object") return;
      const next = clampPanelPos(pos);
      panel.style.setProperty("--editor-panel-x", `${next.x}px`);
      panel.style.setProperty("--editor-panel-y", `${next.y}px`);
    };

    const persistPanelPos = () => {
      try {
        if (!panelPosKey) return;
        const next = clampPanelPos(readCurrentPanelPos());
        window.localStorage.setItem(panelPosKey, JSON.stringify(next));
      } catch {}
    };

    const clampCurrentPanelPos = (persist = false) => {
      applyPanelPos(readCurrentPanelPos());
      if (persist) persistPanelPos();
    };

    applyPanelPos(readPanelPos() ?? { x: 0, y: 0 });

    if (dragButton instanceof HTMLButtonElement && dragSurface instanceof HTMLElement) {
      let moving = null;

      const end = () => {
        if (!moving) return;
        moving = null;
        persistPanelPos();
      };

      const start = (event) => {
        if (!(event instanceof PointerEvent)) return;
        const target = event.target;
        if (
          target instanceof HTMLElement &&
          target.closest("a, button:not([data-style-drag]), details, input, select, textarea, summary")
        ) {
          return;
        }

        moving = {
          startX: event.clientX,
