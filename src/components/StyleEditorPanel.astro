        block.element.style.transformOrigin = "center center";
        block.element.style.zIndex = `${clamp(toNumber(state.z, 30), styleRanges.z.min, styleRanges.z.max)}`;
        if (block.resizable && state.w) {
          block.element.style.setProperty("width", `${toNumber(state.w, 0)}px`);
