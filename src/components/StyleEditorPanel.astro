        const margin = 8;
        const left = clamp(
          rect.left + rect.width / 2 - toolbarRect.width / 2,
          margin,
          Math.max(margin, window.innerWidth - toolbarRect.width - margin),
        );
        const top = clamp(
          rect.top - toolbarRect.height - 10,
          margin,
          Math.max(margin, window.innerHeight - toolbarRect.height - margin),
        );
