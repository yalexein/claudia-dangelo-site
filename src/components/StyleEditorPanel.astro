      try {
        if (storageKey) window.localStorage.removeItem(storageKey);
        customStorageKeys.forEach((bucketKey) => {
          window.localStorage.removeItem(bucketKey);
        });
      } catch (error) {
        console.warn("Impossibile rimuovere le impostazioni.", error);
      }
      setStatus("Impostazioni resettate");
    });

    saveButton?.addEventListener("click", () => {
      persistState(true);
      try {
        window.dispatchEvent(
          new CustomEvent("style-editor:save-all", {
            detail: { storageKey },
          }),
        );
      } catch {}
    });

    // Autosave every minute: persist editor state + notify page-level buckets (textboxes, guestbook, etc.)
    window.setInterval(() => {
      try {
        persistState(false);
        window.dispatchEvent(
          new CustomEvent("style-editor:save-all", {
            detail: { storageKey },
          }),
        );
      } catch {}
