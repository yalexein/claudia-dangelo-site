          const childBeforeStart = range.startOffset > 0 ? range.startContainer.childNodes[range.startOffset - 1] : null;
          const fromStart = getFirstElementFromNode(childAtStart);
          const fromBefore = getFirstElementFromNode(childBeforeStart);
