---
import SitePageHeader from "../../components/SitePageHeader.astro";
import "../../styles/contatti.css";
import "../../styles/site-page-header.css";
import {
  siBluesky,
  siFacebook,
  siGithub,
  siInstagram,
  siMastodon,
  siPinterest,
  siSubstack,
  siThreads,
  siTiktok,
  siX,
  siYoutube,
} from "simple-icons";

const base = import.meta.env.BASE_URL;
const imageSrc = `${base}images/contatti/al-telefono-guardano-non-so-cosa.jpg`;
const email = "clahoudini_art@proton.me";
const contactIconLibrary = {
  instagram: siInstagram.path,
  mastodon: siMastodon.path,
  substack: siSubstack.path,
  bluesky: siBluesky.path,
  facebook: siFacebook.path,
  threads: siThreads.path,
  x: siX.path,
  youtube: siYoutube.path,
  tiktok: siTiktok.path,
  pinterest: siPinterest.path,
  github: siGithub.path,
};
---

<!doctype html>
<html lang="it" data-locale="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta
      name="description"
      content="Contatti di Claudia D'Angelo: collage, scrittura e collaborazioni."
    />
    <meta name="theme-color" content="#70cabc" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Contatti — Claudia D'Angelo" />
    <meta
      property="og:description"
      content="Scrivi a Claudia D'Angelo per collage, scrittura e collaborazioni."
    />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:locale:alternate" content="en_US" />
    <title>Contatti — Claudia D'Angelo</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}site-settings.css?v=1`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400;6..96,500&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
    />
    <script is:inline src={`${base}site-locale.js?v=2`}></script>
    <script id="contact-icon-library" type="application/json" set:html={JSON.stringify(contactIconLibrary)}></script>
    <script is:inline src={`${base}contact-customizer.js?v=20260809-2`}></script>
  </head>
  <body>
    <SitePageHeader pageNameIt="Contatti" pageNameEn="Contact" editKey="contact-header" />

    <main class="contact-public" data-contact-edit="page">
      <div class="contact-shell" data-contact-edit="layout">
        <figure class="contact-visual" data-contact-edit="image-box">
          <img
            data-contact-edit="image"
            src={imageSrc}
            alt="Una sala vintage vista attraverso un grande portale circolare, con persone intorno a un acquario cilindrico"
            data-alt-it="Una sala vintage vista attraverso un grande portale circolare, con persone intorno a un acquario cilindrico"
            data-alt-en="A vintage room seen through a large circular portal, with people gathered around a cylindrical aquarium"
            width="3302"
            height="2079"
            loading="eager"
            decoding="async"
          />

        </figure>

        <section class="contact-panel" data-contact-edit="panel" aria-label="Contatti / Contact">
          <div class="contact-panel__inner" data-contact-edit="panel-inner">
            <header class="contact-heading" data-contact-edit="heading">
              <p class="contact-kicker" data-contact-edit="kicker">Claudia D'Angelo</p>

              <div data-locale-only="it">
                <h1 id="contact-title-it" data-contact-edit="title-it">contatti</h1>
              </div>

              <div data-locale-only="en" hidden>
                <h1 id="contact-title-en" data-contact-edit="title-en">contact</h1>
              </div>

              <nav class="contact-social-icons" data-contact-edit="social-icons" aria-label="Social network">
                <a
                  data-contact-edit="instagram-main"
                  data-social-icon="instagram"
                  href="https://www.instagram.com/clahoudini_/"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Instagram — Claudia D'Angelo"
                  title="Instagram — Claudia D'Angelo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siInstagram.path}></path></svg>
                </a>
                <a
                  class="contact-social-icon--collage"
                  data-contact-edit="instagram-collage"
                  data-social-icon="instagram"
                  href="https://www.instagram.com/clahoudini_art/"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Instagram — collage"
                  title="Instagram — collage"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siInstagram.path}></path></svg>
                  <span class="contact-social-badge" data-contact-edit="collage-badge" aria-hidden="true">collage</span>
                </a>
                <a
                  data-contact-edit="substack"
                  data-social-icon="substack"
                  href="https://substack.com/@claudiadangelo"
                  target="_blank"
                  rel="noreferrer"
                  aria-label="Substack — Claudia D'Angelo"
                  title="Substack — Claudia D'Angelo"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siSubstack.path}></path></svg>
                </a>
                <a
                  data-contact-edit="mastodon"
                  data-social-icon="mastodon"
                  href="https://livellosegreto.it/@clahoudini"
                  target="_blank"
                  rel="me noreferrer"
                  aria-label="Mastodon — @clahoudini"
                  title="Mastodon — @clahoudini"
                >
                  <svg viewBox="0 0 24 24" aria-hidden="true"><path d={siMastodon.path}></path></svg>
                </a>
              </nav>

              <div data-locale-only="it" data-contact-edit="intro-wrap-it">
                <p class="contact-intro" data-contact-edit="intro-it">
                  <span data-contact-edit="intro-copy-it">Puoi trovarmi online su Instagram, Substack e Mastodon. Se vuoi commissionarmi un collage
                    o vuoi iniziare una collaborazione o qualsiasi altra cosa dalla scrittura ai collage ai
                    complimenti alle critiche puoi scrivermi qui: </span>
                  <a data-contact-edit="email-it" href={`mailto:${email}`}>clahoudini_art(at)proton(dot)me</a><br />
                  <span data-contact-edit="intro-closing-it">Altrimenti, scrivimi un commento nel box qui sotto : )</span>
                </p>
              </div>

              <div data-locale-only="en" data-contact-edit="intro-wrap-en" hidden>
                <p class="contact-intro" data-contact-edit="intro-en">
                  <span data-contact-edit="intro-copy-en">You can find me online on Instagram, Substack and Mastodon. If you would like to commission
                    a collage, start a collaboration, or write about anything from words and collages to
                    compliments and criticism, email me at </span>
                  <a data-contact-edit="email-en" href={`mailto:${email}`}>clahoudini_art(at)proton(dot)me</a>.<br />
                  <span data-contact-edit="intro-closing-en">Otherwise, leave me a comment in the box below : )</span>
                </p>
              </div>
            </header>

            <section class="guestbook" data-contact-edit="guestbook" aria-label="Guestbook">
              <header class="guestbook__heading" data-contact-edit="guestbook-heading">
                <div data-locale-only="it">
                  <h2 data-contact-edit="guestbook-title-it">guestbook</h2>
                </div>
                <div data-locale-only="en" hidden>
                  <h2 data-contact-edit="guestbook-title-en">guestbook</h2>
                </div>
              </header>

              <form class="guestbook__form" data-contact-edit="guestbook-form" data-guestbook-form>
                <label class="guestbook__field" data-contact-edit="name-field">
                  <span data-locale-only="it" data-contact-edit="name-label-it">il tuo nome</span>
                  <span data-locale-only="en" data-contact-edit="name-label-en" hidden>your name</span>
                  <input data-contact-edit="name-input" name="name" type="text" autocomplete="name" maxlength="60" required />
                </label>

                <label class="guestbook__field guestbook__field--message" data-contact-edit="message-field">
                  <span data-locale-only="it" data-contact-edit="message-label-it">il tuo messaggio</span>
                  <span data-locale-only="en" data-contact-edit="message-label-en" hidden>your message</span>
                  <textarea data-contact-edit="message-input" name="message" rows="4" maxlength="500" required data-guestbook-message></textarea>
                </label>

                <label class="guestbook__honeypot" aria-hidden="true">
                  Website
                  <input name="website" type="text" tabindex="-1" autocomplete="off" />
                </label>

                <div class="guestbook__submit-row" data-contact-edit="submit-row">
                  <span class="guestbook__count" data-contact-edit="counter" data-guestbook-count>0 / 500</span>
                  <button type="submit" data-contact-edit="submit-button" data-guestbook-submit>
                    <span data-locale-only="it" data-contact-edit="submit-it">pubblica</span>
                    <span data-locale-only="en" data-contact-edit="submit-en" hidden>publish</span>
                  </button>
                </div>

                <p class="guestbook__status" data-guestbook-status role="status" aria-live="polite"></p>
              </form>

              <div class="guestbook__entries" data-contact-edit="guestbook-entries" data-guestbook-list aria-live="polite"></div>
            </section>

          </div>
        </section>
      </div>
    </main>

    <script is:inline>
      (() => {
        const applyLocalizedDetails = () => {
          const locale = document.documentElement.dataset.locale === "en" ? "en" : "it";
          document.title = locale === "en" ? "Contact — Claudia D'Angelo" : "Contatti — Claudia D'Angelo";

          const description = document.querySelector('meta[name="description"]');
          if (description) {
            description.setAttribute(
              "content",
              locale === "en"
                ? "Contact Claudia D'Angelo for collage, writing and collaborations."
                : "Contatti di Claudia D'Angelo: collage, scrittura e collaborazioni.",
            );
          }

          document.querySelector(".site-language-switcher")?.setAttribute(
            "aria-label",
            locale === "en" ? "Language" : "Lingua",
          );

          const image = document.querySelector(".contact-visual img");
          if (image instanceof HTMLImageElement) {
            image.alt = locale === "en" ? image.dataset.altEn || image.alt : image.dataset.altIt || image.alt;
          }

        };

        document.addEventListener("claudia:locale-ready", applyLocalizedDetails);
        window.addEventListener("DOMContentLoaded", applyLocalizedDetails, { once: true });

        const guestbookForm = document.querySelector("[data-guestbook-form]");
        const guestbookList = document.querySelector("[data-guestbook-list]");
        const guestbookStatus = document.querySelector("[data-guestbook-status]");
        const guestbookMessage = document.querySelector("[data-guestbook-message]");
        const guestbookCount = document.querySelector("[data-guestbook-count]");
        const guestbookSubmit = document.querySelector("[data-guestbook-submit]");

        const guestbookCopy = {
          it: {
            loading: "Carico i messaggi…",
            error: "Il guestbook non è raggiungibile. Riprova tra poco.",
            sending: "Pubblico il messaggio…",
            success: "Il tuo messaggio è nel guestbook.",
          },
          en: {
            loading: "Loading messages…",
            error: "The guestbook is unavailable. Please try again shortly.",
            sending: "Publishing your message…",
            success: "Your message is now in the guestbook.",
          },
        };

        const guestbookLocale = () => (document.documentElement.dataset.locale === "en" ? "en" : "it");
        const setGuestbookStatus = (message, state = "") => {
          if (!(guestbookStatus instanceof HTMLElement)) return;
          guestbookStatus.textContent = message;
          guestbookStatus.dataset.state = state;
        };

        const updateCount = () => {
          if (!(guestbookMessage instanceof HTMLTextAreaElement) || !(guestbookCount instanceof HTMLElement)) return;
          guestbookCount.textContent = `${guestbookMessage.value.length} / 500`;
        };

        const renderGuestbook = (entries) => {
          if (!(guestbookList instanceof HTMLElement)) return;
          guestbookList.replaceChildren();
          const locale = guestbookLocale();

          if (!Array.isArray(entries) || entries.length === 0) {
            return;
          }

          for (const entry of entries) {
            const article = document.createElement("article");
            article.className = "guestbook-entry";
            const header = document.createElement("header");
            const name = document.createElement("strong");
            const date = document.createElement("time");
            const message = document.createElement("p");

            name.textContent = String(entry.name || "");
            date.dateTime = String(entry.createdAt || "");
            date.textContent = new Intl.DateTimeFormat(locale === "en" ? "en-IE" : "it-IT", {
              day: "2-digit",
              month: "short",
              year: "numeric",
            }).format(new Date(entry.createdAt));
            message.textContent = String(entry.message || "");

            header.append(name, date);
            article.append(header, message);
            guestbookList.appendChild(article);
          }
        };

        const loadGuestbook = async () => {
          const locale = guestbookLocale();
          setGuestbookStatus(guestbookCopy[locale].loading);
          try {
            const response = await fetch("/api/guestbook", { headers: { Accept: "application/json" } });
            if (!response.ok) throw new Error("guestbook unavailable");
            const payload = await response.json();
            renderGuestbook(payload.entries);
            setGuestbookStatus("");
          } catch {
            setGuestbookStatus(guestbookCopy[locale].error, "error");
          }
        };

        guestbookMessage?.addEventListener("input", updateCount);
        updateCount();

        guestbookForm?.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (!(guestbookForm instanceof HTMLFormElement)) return;
          const locale = guestbookLocale();
          const formData = new FormData(guestbookForm);
          const payload = {
            name: String(formData.get("name") || "").trim(),
            message: String(formData.get("message") || "").trim(),
            website: String(formData.get("website") || "").trim(),
          };

          if (guestbookSubmit instanceof HTMLButtonElement) guestbookSubmit.disabled = true;
          setGuestbookStatus(guestbookCopy[locale].sending);

          try {
            const response = await fetch("/api/guestbook", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify(payload),
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.error || "guestbook unavailable");
            renderGuestbook(result.entries);
            guestbookForm.reset();
            updateCount();
            setGuestbookStatus(guestbookCopy[locale].success, "success");
          } catch {
            setGuestbookStatus(guestbookCopy[locale].error, "error");
          } finally {
            if (guestbookSubmit instanceof HTMLButtonElement) guestbookSubmit.disabled = false;
          }
        });

        document.addEventListener("claudia:locale-ready", () => {
          updateCount();
          void loadGuestbook();
        });
        void loadGuestbook();
      })();
    </script>
  </body>
</html>
