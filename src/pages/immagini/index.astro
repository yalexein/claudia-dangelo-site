---
import BioLayout from "../../layouts/BioLayout.astro";
import "../../styles/uccelli.css";
import "../../styles/image-board.css";

const base = import.meta.env.BASE_URL;
const namespace = "immagini";
---

<BioLayout title="Immagini">
  <main
    class="image-board-page uccelli-page"
    data-advanced-editor-root
    data-advanced-editor-namespace={namespace}
  >
    <header class="image-board-toolbar" aria-label="Editor immagini">
      <a class="image-board-toolbar__brand" href={base} aria-label="Torna alla home">Claudia D'Angelo</a>

      <nav class="image-board-menubar" aria-label="Menu editor immagini">
        <details class="image-board-menu" data-image-board-menu>
          <summary class="image-board-menu__summary">File</summary>
          <div class="image-board-menu__panel image-board-toolbar__group" role="menu" aria-label="File">
            <button class="image-board-button image-board-button--primary" type="button" data-uccelli-image-upload-btn>
              Importa PNG/JPG
            </button>
            <button class="image-board-button image-board-button--primary" type="button" data-uccelli-sprite-upload-btn>
              Importa Sprite
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-demo-seed-btn>
              Demo
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-image-export-data-btn>
              Esporta pacchetto
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-image-import-data-btn>
              Importa pacchetto/JSON
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-image-export-page-btn>
              Esporta HTML pubblico
            </button>
          </div>
        </details>

        <details class="image-board-menu" data-image-board-menu>
          <summary class="image-board-menu__summary">Modifica</summary>
          <div class="image-board-menu__panel image-board-toolbar__group" role="menu" aria-label="Modifica">
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-image-select-all-btn>
              Seleziona tutto
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-image-center-all-btn>
              Centra tutto
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-panels-close-btn>
              Chiudi pannelli
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-panels-reset-btn>
              Reset UI
            </button>
            <button class="image-board-button image-board-button--secondary image-board-menu__danger" type="button" data-uccelli-image-clear-btn>
              Elimina selezione
            </button>
          </div>
        </details>

        <details class="image-board-menu" data-image-board-menu>
          <summary class="image-board-menu__summary">Vista</summary>
          <div class="image-board-menu__panel image-board-toolbar__group" role="menu" aria-label="Vista">
            <button class="image-board-button image-board-button--secondary" type="button" data-image-board-public-mode-btn>
              Vista pubblica
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-layers-menu-toggle>
              Mostra/Nascondi livelli
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" aria-pressed="false" data-image-board-inspector-dock-toggle>
              Inspector: Flottante
            </button>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide" data-image-board-menu>
          <summary class="image-board-menu__summary">Layer</summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--layers" role="menu" aria-label="Livelli immagine">
            <div class="image-board-menu__row" aria-label="Ordine layer">
              <button class="image-board-icon-button" type="button" title="Porta in fondo" aria-label="Porta in fondo" data-uccelli-image-layer-bottom-btn>
                ⇣
              </button>
              <button class="image-board-icon-button" type="button" title="Manda indietro" aria-label="Manda indietro" data-uccelli-image-layer-down-btn>
                ↓
              </button>
              <button class="image-board-icon-button" type="button" title="Porta avanti" aria-label="Porta avanti" data-uccelli-image-layer-up-btn>
                ↑
              </button>
              <button class="image-board-icon-button" type="button" title="Porta in cima" aria-label="Porta in cima" data-uccelli-image-layer-top-btn>
                ⇡
              </button>
            </div>
            <label class="image-board-layer-control" for={`${namespace}-image-z`}>
              <span>Layer</span>
              <input id={`${namespace}-image-z`} type="range" min="0" max="200" step="1" value="20" data-uccelli-image-z />
              <output data-uccelli-image-value="z">20</output>
            </label>
            <label class="image-board-layer-control image-board-layer-control--opacity" for={`${namespace}-image-opacity`}>
              <span>Opacità</span>
              <input id={`${namespace}-image-opacity`} type="range" min="0" max="100" step="1" value="100" data-uccelli-image-opacity />
              <output data-uccelli-image-value="opacity">100%</output>
            </label>
            <label class="image-board-effect-control image-board-blend-control" for={`${namespace}-image-blend`}>
              <span>Fusione</span>
              <select id={`${namespace}-image-blend`} data-uccelli-image-blend>
                <option value="normal">Normale</option>
                <option value="multiply">Moltiplica</option>
                <option value="screen">Scolora</option>
                <option value="overlay">Sovrapponi</option>
                <option value="darken">Scurisci</option>
                <option value="lighten">Schiarisci</option>
                <option value="color-burn">Brucia</option>
                <option value="color-dodge">Scherma</option>
                <option value="difference">Differenza</option>
                <option value="luminosity">Luminosità</option>
              </select>
            </label>
            <div class="image-board-menu__row">
              <button class="image-board-button image-board-button--secondary image-board-layer-toggle" type="button" title="Mostra o nasconde questo livello" data-uccelli-image-visibility-btn>
                Nascondi
              </button>
              <button class="image-board-button image-board-button--secondary image-board-layer-toggle" type="button" title="Blocca spostamento, scala e rotazione" data-uccelli-image-lock-btn>
                Blocca
              </button>
            </div>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide" data-image-board-menu>
          <summary class="image-board-menu__summary">Effetti</summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--effects" role="menu" aria-label="Effetti e link immagine">
            <label class="image-board-effect-control" for={`${namespace}-hover-effect`}>
              <span>Mouse sopra</span>
              <select id={`${namespace}-hover-effect`} data-uccelli-image-hover-effect>
                <option value="none">Nessuno</option>
                <option value="lift">Solleva</option>
                <option value="zoom">Zoom</option>
                <option value="tilt">Tilt</option>
                <option value="glow">Glow</option>
                <option value="gray-color">B/N → colore</option>
                <option value="opacity">Trasparenza</option>
                <option value="paper">Carta viva</option>
              </select>
            </label>

            <label class="image-board-effect-control" for={`${namespace}-click-effect`}>
              <span>Click</span>
              <select id={`${namespace}-click-effect`} data-uccelli-image-click-effect>
                <option value="none">Nessuno</option>
                <option value="pulse">Pulse</option>
                <option value="pop">Pop</option>
                <option value="flash">Flash</option>
                <option value="spin">Giro</option>
                <option value="open-link">Apri link</option>
                <option value="lock-toggle">Blocca/sblocca</option>
                <option value="bring-front">Porta davanti</option>
              </select>
            </label>

            <label class="image-board-link-control" for={`${namespace}-image-link`}>
              <span>Link</span>
              <input
                id={`${namespace}-image-link`}
                type="text"
                list={`${namespace}-site-links`}
                placeholder="/bio/"
                data-uccelli-image-link
              />
            </label>
            <label class="image-board-effect-control image-board-link-preset-control" for={`${namespace}-image-link-preset`}>
              <span>Pagine</span>
              <select id={`${namespace}-image-link-preset`} data-uccelli-image-link-preset>
                <option value="">Scegli...</option>
                <option value="/">Home</option>
                <option value="/bio/">Bio</option>
                <option value="/scritture/">Scritture</option>
                <option value="/collages/">Collages</option>
                <option value="/sketches/">Sketches</option>
                <option value="/il-vizio-della-scrittura/">Il vizio</option>
                <option value="/ispirazioni/">Ispirazioni</option>
                <option value="/ricerche/">Ricerche</option>
                <option value="/blog/">Blog</option>
                <option value="/eventi/">Eventi</option>
                <option value="/contatti/">Contatti</option>
              </select>
            </label>
            <datalist id={`${namespace}-site-links`}>
              <option value="/" label="Home"></option>
              <option value="/bio/" label="Bio"></option>
              <option value="/scritture/" label="Scritture"></option>
              <option value="/collages/" label="Collages"></option>
              <option value="/sketches/" label="Sketches"></option>
              <option value="/il-vizio-della-scrittura/" label="Il vizio"></option>
              <option value="/ispirazioni/" label="Ispirazioni"></option>
              <option value="/ricerche/" label="Ricerche"></option>
              <option value="/blog/" label="Blog"></option>
              <option value="/eventi/" label="Eventi"></option>
              <option value="/contatti/" label="Contatti"></option>
            </datalist>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide image-board-menu--advanced" data-image-board-menu>
          <summary class="image-board-menu__summary">Animazione</summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--advanced" role="menu" aria-label="Animazione e movimento">
            <section class="image-board-menu__section" aria-label="Preset movimento">
              <h3>Movimento layer</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="motion-none" data-requires-image>Fermo</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="motion-float" data-requires-image>Fluttua</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="motion-orbit" data-requires-image>Orbita</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="motion-scroll-left" data-requires-image>Scorre</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Percorso e trigger">
              <h3>Percorso</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="path-toggle" data-requires-image>Play/Pausa percorso</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="path-point" data-requires-image>Punto da canvas</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="path-clear" data-requires-image>Pulisci percorso</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Inspector movimento">
              <button class="image-board-button image-board-button--primary" type="button" aria-controls={`${namespace}-motion-panel`} aria-expanded="false" data-uccelli-motion-panel-toggle>
                Inspector movimento
              </button>
            </section>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide image-board-menu--advanced" data-image-board-menu data-image-board-context-menu="sprite">
          <summary class="image-board-menu__summary">
            <span data-image-board-context-label="sprite">Sprite</span>
            <span class="image-board-menu__badge" data-image-board-context-badge="sprite" hidden></span>
          </summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--advanced" role="menu" aria-label="Sprite animati">
            <section class="image-board-menu__section" aria-label="Sprite selezionato" data-context-section="sprite-active">
              <h3 data-image-board-context-title="sprite">Sprite selezionato</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="sprite-play" data-requires-sprite>Play/Pausa</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="sprite-prev" data-requires-sprite>Frame -</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="sprite-next" data-requires-sprite>Frame +</button>
                <button class="image-board-button image-board-button--secondary" type="button" aria-controls={`${namespace}-sprite-panel`} aria-expanded="false" data-uccelli-sprite-panel-toggle>
                  Inspector sprite
                </button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Import sprite" data-context-section="sprite-empty">
              <h3>Nessuno sprite selezionato</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="sprite-import">Importa sprite</button>
                <button class="image-board-button image-board-button--secondary" type="button" aria-controls={`${namespace}-sprite-panel`} aria-expanded="false" data-uccelli-sprite-panel-toggle>
                  Inspector sprite
                </button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Sprite direzionale" data-context-section="sprite-tools">
              <h3>Direzioni</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="sprite-directional" data-requires-sprite>Direzionale</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="sprite-sync" data-requires-sprite>Sync movimento</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="sprite-fit" data-requires-sprite>Uniforma frame</button>
              </div>
            </section>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide image-board-menu--advanced" data-image-board-menu>
          <summary class="image-board-menu__summary">Scontorna</summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--advanced" role="menu" aria-label="Scontorno immagine">
            <section class="image-board-menu__section" aria-label="Azioni scontorno">
              <h3>Maschera</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="cutout-apply" data-requires-image>Applica scontorno</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="cutout-reset" data-requires-image>Ripristina</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Inspector scontorno">
              <button class="image-board-button image-board-button--secondary" type="button" aria-controls={`${namespace}-cutout-panel`} aria-expanded="false" data-uccelli-cutout-panel-toggle>
                Inspector scontorno
              </button>
            </section>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide image-board-menu--advanced" data-image-board-menu>
          <summary class="image-board-menu__summary">Sfondo</summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--advanced" role="menu" aria-label="Sfondo canvas">
            <section class="image-board-menu__section" aria-label="Preset sfondo">
              <h3>Canvas</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="background-gradient">Gradiente on/off</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="background-paper">Carta on/off</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="background-grid">Griglia editor</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="background-reset">Reset sfondo</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Inspector sfondo">
              <button class="image-board-button image-board-button--primary" type="button" aria-controls={`${namespace}-background-panel`} aria-expanded="false" data-uccelli-background-panel-toggle>
                Inspector sfondo
              </button>
            </section>
          </div>
        </details>

        <details class="image-board-menu image-board-menu--wide image-board-menu--advanced" data-image-board-menu data-image-board-context-menu="game">
          <summary class="image-board-menu__summary">
            <span data-image-board-context-label="game">Gioco 2D</span>
            <span class="image-board-menu__badge" data-image-board-context-badge="game" hidden></span>
          </summary>
          <div class="image-board-menu__panel image-board-toolbar__group image-board-toolbar__group--advanced" role="menu" aria-label="Gioco 2D">
            <section class="image-board-menu__section" aria-label="Player selezionato" data-context-section="game-player">
              <h3>Player selezionato</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="game-preview">Preview gioco</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-reset">Reset player</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-spawn">Piazza spawn</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-walk">Disegna zona</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-depth" data-requires-image>Profondità Y</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Ostacolo selezionato" data-context-section="game-obstacle">
              <h3>Ostacolo selezionato</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="game-depth" data-requires-image>Profondità Y</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-role-player" data-requires-image>Trasforma in player</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-preview">Preview gioco</button>
                <button class="image-board-button image-board-button--secondary" type="button" aria-controls={`${namespace}-game-panel`} aria-expanded="false" data-uccelli-game-panel-toggle>
                  Inspector gioco
                </button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Preview gioco" data-context-section="game-default">
              <h3>Stanza</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--primary" type="button" data-image-board-menu-action="game-preview">Preview gioco</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-reset">Reset player</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-spawn">Piazza spawn</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-walk">Disegna zona</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Asset gioco">
              <h3>Layer selezionato</h3>
              <div class="image-board-menu__row">
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-role-player" data-requires-image>Player</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-role-obstacle" data-requires-image>Ostacolo</button>
                <button class="image-board-button image-board-button--secondary" type="button" data-image-board-menu-action="game-depth" data-requires-image>Profondità Y</button>
              </div>
            </section>
            <section class="image-board-menu__section" aria-label="Inspector gioco">
              <button class="image-board-button image-board-button--primary" type="button" aria-controls={`${namespace}-game-panel`} aria-expanded="false" data-uccelli-game-panel-toggle>
                Inspector gioco
              </button>
            </section>
          </div>
        </details>
      </nav>

      <div class="image-board-quick-actions" aria-label="Stato e cronologia immagini">
        <button class="image-board-button image-board-button--primary image-board-command-button" type="button" title="Comandi (Cmd+K)" data-image-board-command-palette-open>
          Comandi <kbd>Cmd+K</kbd>
        </button>
        <button class="image-board-button image-board-button--secondary image-board-history-button" type="button" title="Annulla (Cmd+Z)" data-uccelli-image-undo-btn disabled>
          ↶ Annulla
        </button>
        <button class="image-board-button image-board-button--secondary image-board-history-button" type="button" title="Ripeti (Cmd+Shift+Z)" data-uccelli-image-redo-btn disabled>
          Ripeti ↷
        </button>
      </div>
      <p class="image-board-status" data-uccelli-image-status aria-live="polite">Nessuna immagine</p>
    </header>

    <div class="image-board-command-palette" data-image-board-command-palette hidden>
      <button class="image-board-command-palette__backdrop" type="button" aria-label="Chiudi comandi" data-image-board-command-palette-close></button>
      <section class="image-board-command-palette__panel" role="dialog" aria-modal="true" aria-labelledby={`${namespace}-command-palette-title`}>
        <div class="image-board-command-palette__bar">
          <h2 id={`${namespace}-command-palette-title`}>Comandi</h2>
          <button class="image-board-icon-button" type="button" title="Chiudi" aria-label="Chiudi" data-image-board-command-palette-close>×</button>
        </div>
        <label class="image-board-command-palette__search" for={`${namespace}-command-palette-search`}>
          <span>Cerca</span>
          <input
            id={`${namespace}-command-palette-search`}
            type="search"
            placeholder="Esporta, Piazza spawn, Scontorna..."
            autocomplete="off"
            spellcheck="false"
            data-image-board-command-palette-input
            aria-controls={`${namespace}-command-palette-results`}
          />
        </label>
        <div id={`${namespace}-command-palette-results`} class="image-board-command-palette__list" role="listbox" data-image-board-command-palette-list></div>
        <p class="image-board-command-palette__empty" data-image-board-command-palette-empty hidden>Nessun comando trovato.</p>
      </section>
    </div>

    <section class="image-board-stage" aria-label="Tavola immagini">
      <div class="image-board-empty" data-uccelli-image-empty>
        <button class="image-board-empty__button" type="button" data-uccelli-image-upload-btn>Importa PNG/JPG</button>
      </div>
      <div class="uccelli-image-layer image-board-image-layer" data-uccelli-image-layer aria-label="Immagini PNG e JPG libere"></div>
      <div class="uccelli-gallery-layer image-board-gallery-layer" data-uccelli-gallery-layer aria-hidden="true"></div>
    </section>

    <aside class="uccelli-layers-panel image-board-layers-panel" data-uccelli-layers-panel aria-label="Livelli immagini">
      <div class="uccelli-layers-panel__bar" data-uccelli-layers-drag>
