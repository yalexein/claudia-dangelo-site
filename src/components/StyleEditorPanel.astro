      const normalizeLinkHref = (value) => {
        const raw = `${value ?? ""}`.trim();
        if (!raw) return "";
        if (/^(javascript|data|vbscript):/i.test(raw)) return "";
        if (/^(https?:|mailto:|tel:)/i.test(raw) || raw.startsWith("/") || raw.startsWith("#")) return raw;
