        const offsetX = Number.isFinite(numbers[0]) ? numbers[0] : fallback.length;
        const offsetY = Number.isFinite(numbers[1]) ? numbers[1] : offsetX;
        const blur = Number.isFinite(numbers[2]) ? numbers[2] : fallback.thickness;

        return {
          enabled: true,
          color: normalizeColor(colorMatch?.[0] ?? fallback.color, fallback.color),
          thickness: clamp(Math.round(Math.abs(blur)), 0, 80),
          length: clamp(Math.round(Math.max(Math.abs(offsetX), Math.abs(offsetY))), 0, 140),
        };
      };

      const getRichShadowSettings = () => ({
        color: richShadowColorInput.value || "#000000",
        thickness: clamp(toNumber(richShadowThicknessInput.value, 6), 0, 80),
        length: clamp(toNumber(richShadowLengthInput.value, 4), 0, 140),
      });

      const buildRichTextShadow = () => {
        const shadow = getRichShadowSettings();
        richShadowThicknessInput.value = `${shadow.thickness}`;
        richShadowLengthInput.value = `${shadow.length}`;
        return `${shadow.length}px ${shadow.length}px ${shadow.thickness}px ${shadow.color}`;
      };

      const applyLinkToSelection = () => {
        const restoredBeforePrompt = restoreRichSelection();
        if (!restoredBeforePrompt || restoredBeforePrompt.selection.isCollapsed) return;

        const currentHref = closestRichLink(restoredBeforePrompt.range)?.getAttribute("href") ?? "";
        const input = window.prompt("Incolla il link web", currentHref);
        if (input === null) {
          showRichToolbarForSelection();
          return;
        }

        const restored = restoreRichSelection();
        if (!restored || restored.selection.isCollapsed) return;

        const existingLink = closestRichLink(restored.range);
        const href = normalizeLinkHref(input);
        if (!href) {
          if (`${input ?? ""}`.trim() === "") {
            document.execCommand("unlink", false);
            syncRichBlockAfterChange(restored.block);
            setStatus("Link rimosso");
          } else {
            setStatus("Link non valido");
          }
          showRichToolbarForSelection();
          return;
        }

        const shouldUpdateExisting = existingLink && restored.block.element.contains(existingLink);
        const link = shouldUpdateExisting ? existingLink : document.createElement("a");
        link.href = href;
        link.target = "_blank";
        link.rel = "noreferrer";

        if (!shouldUpdateExisting) {
          try {
            restored.range.surroundContents(link);
          } catch {
            const fragment = restored.range.extractContents();
            link.appendChild(fragment);
            restored.range.insertNode(link);
          }
        }

        const nextRange = document.createRange();
        nextRange.selectNodeContents(link);
        restored.selection.removeAllRanges();
        restored.selection.addRange(nextRange);
        savedRichRange = nextRange.cloneRange();
        savedRichBlockId = restored.block.id;
        syncRichBlockAfterChange(restored.block);
        setStatus("Link aggiunto");
        showRichToolbarForSelection();
      };

      const syncRichBlockAfterChange = (block) => {
        const state = stateById.get(block.id);
        if (!state) return;
        state.text = extractBlockText(block);
        if (activeBlockId === block.id) textArea.value = state.text;
        scheduleContentSave();
      };

      const wrapRichSelection = (styles) => {
        const restored = restoreRichSelection();
        if (!restored || restored.selection.isCollapsed) return;
        const span = document.createElement("span");
        const resetDescendantStyles = (root, styleKeys) => {
          root.querySelectorAll("*").forEach((node) => {
            if (!(node instanceof HTMLElement)) return;
            styleKeys.forEach((key) => {
              if (key === "WebkitTextFillColor") {
                node.style.removeProperty("-webkit-text-fill-color");
                return;
              }
              node.style[key] = "";
            });

            if (!node.getAttribute("style")?.trim()) node.removeAttribute("style");
          });
        };
        const styleKeys = Object.keys(styles).filter((key) => styles[key] !== null);

        Object.entries(styles).forEach(([key, value]) => {
          if (value === null) return;
          span.style[key] = `${value}`;
        });

        try {
          restored.range.surroundContents(span);
        } catch {
          const fragment = restored.range.extractContents();
          span.appendChild(fragment);
          restored.range.insertNode(span);
        }

        resetDescendantStyles(span, styleKeys);
        const nextRange = document.createRange();
        nextRange.selectNodeContents(span);
        restored.selection.removeAllRanges();
        restored.selection.addRange(nextRange);
        savedRichRange = nextRange.cloneRange();
        savedRichBlockId = restored.block.id;
        syncRichBlockAfterChange(restored.block);
        showRichToolbarForSelection();
      };

      const unwrapRichSelection = () => {
        const restored = restoreRichSelection();
        if (!restored || restored.selection.isCollapsed) return;
        document.execCommand("removeFormat", false);
        syncRichBlockAfterChange(restored.block);
        showRichToolbarForSelection();
      };

      richFontSelect.addEventListener("change", () => {
        if (!richFontSelect.value) return;
        wrapRichSelection({ fontFamily: richFontSelect.value });
      });

      richSizeInput.addEventListener("change", () => {
        const nextSize = clamp(toNumber(richSizeInput.value, 16), 8, 140);
        richSizeInput.value = `${nextSize}`;
        wrapRichSelection({ fontSize: `${nextSize}px` });
      });

      richLineHeightInput.addEventListener("change", () => {
        const block = blockById.get(activeBlockId);
        if (!block || block.richMode !== "html") return;
        const nextLineHeight = clamp(toNumber(richLineHeightInput.value, 1.47), styleRanges.lineHeight.min, styleRanges.lineHeight.max);
        richLineHeightInput.value = `${nextLineHeight.toFixed(2)}`;
        updateActiveStyle({ lineHeight: nextLineHeight });
        showRichToolbarForSelection();
      });

      richColorInput.addEventListener("input", () => {
        wrapRichSelection({ color: richColorInput.value, WebkitTextFillColor: richColorInput.value });
      });

      const applyRichShadowFromControls = () => {
        wrapRichSelection({ textShadow: buildRichTextShadow() });
      };

      richShadowButton.addEventListener("click", () => {
        const restored = restoreRichSelection();
        if (!restored) return;
        wrapRichSelection({ textShadow: buildRichTextShadow() });
      });

      richShadowColorInput.addEventListener("input", applyRichShadowFromControls);
      richShadowColorInput.addEventListener("change", applyRichShadowFromControls);
      richShadowThicknessInput.addEventListener("change", applyRichShadowFromControls);
      richShadowLengthInput.addEventListener("change", applyRichShadowFromControls);

      richBoldButton.addEventListener("click", () => {
        const restored = restoreRichSelection();
        if (!restored) return;
        const element = getElementFromNode(restored.range.startContainer) ?? restored.block.element;
        const isActive = isBoldValue(getComputedStyle(element).fontWeight);
        wrapRichSelection({ fontWeight: isActive ? "400" : "700" });
      });

      richItalicButton.addEventListener("click", () => {
        const restored = restoreRichSelection();
        if (!restored) return;
        const element = getElementFromNode(restored.range.startContainer) ?? restored.block.element;
        const isActive = isItalicValue(getComputedStyle(element).fontStyle);
        wrapRichSelection({ fontStyle: isActive ? "normal" : "italic" });
      });

      richUnderlineButton.addEventListener("click", () => {
        const restored = restoreRichSelection();
        if (!restored) return;
        const element = getElementFromNode(restored.range.startContainer) ?? restored.block.element;
        const isActive = getComputedStyle(element).textDecorationLine.includes("underline");
        wrapRichSelection({ textDecoration: isActive ? "none" : "underline" });
      });

      richLinkButton.addEventListener("click", applyLinkToSelection);

      richClearButton.addEventListener("click", unwrapRichSelection);

      const applyBlockStyle = (block) => {
        const state = stateById.get(block.id);
        if (!state) return;
        const style = sanitizeBlockStyle(state.style);
        state.style = style;
        block.element.classList.toggle("content-editor-block--custom-style", Object.keys(style).length > 0);

        if (style.fontFamily) block.element.style.fontFamily = style.fontFamily;
        else block.element.style.removeProperty("font-family");

        if (style.fontSize !== undefined) block.element.style.fontSize = `${style.fontSize}px`;
        else block.element.style.removeProperty("font-size");

        if (style.lineHeight !== undefined) {
          block.element.style.lineHeight = `${style.lineHeight}`;
        } else {
          block.element.style.removeProperty("line-height");
        }

        if (style.letterSpacing !== undefined) block.element.style.letterSpacing = `${style.letterSpacing}em`;
        else block.element.style.removeProperty("letter-spacing");

        if (style.wordSpacing !== undefined) block.element.style.wordSpacing = `${style.wordSpacing}em`;
        else block.element.style.removeProperty("word-spacing");

        if (style.textAlign) block.element.style.textAlign = style.textAlign;
        else block.element.style.removeProperty("text-align");

        if (style.fontWeight) block.element.style.fontWeight = style.fontWeight;
        else block.element.style.removeProperty("font-weight");

        if (style.fontStyle) block.element.style.fontStyle = style.fontStyle;
        else block.element.style.removeProperty("font-style");

        if (style.color) {
          block.element.style.setProperty("color", style.color, "important");
          block.element.style.setProperty("-webkit-text-fill-color", style.color);
          block.element.style.setProperty("background-image", "none");
          block.element.style.setProperty("background-clip", "border-box");
          block.element.style.setProperty("-webkit-background-clip", "border-box");
        } else {
          block.element.style.removeProperty("color");
          block.element.style.removeProperty("-webkit-text-fill-color");
          block.element.style.removeProperty("background-image");
          block.element.style.removeProperty("background-clip");
          block.element.style.removeProperty("-webkit-background-clip");
        }
      };

      const applyBlockState = (block) => {
        const state = stateById.get(block.id);
        if (!state) return;
        block.element.hidden = Boolean(state.hidden);
        block.element.dataset.contentEditable = block.editable ? "true" : "false";
        block.element.dataset.contentTransform = block.transform;
        if (extractBlockText(block) !== state.text) {
          writeBlockText(block, state.text);
        }
        applyTransform(block);
        applyBlockStyle(block);
      };

      const getEffectiveStyle = (block) => {
        const state = stateById.get(block.id);
        const style = sanitizeBlockStyle(state?.style);
        const globalStyle = getGlobalStyleDefaults();
        const computed = getComputedStyle(block.element);

        return {
          fontFamily: style.fontFamily ?? globalStyle.fontFamily,
          fontSize: style.fontSize ?? globalStyle.fontSize,
          lineHeight: style.lineHeight ?? globalStyle.lineHeight,
          letterSpacing: style.letterSpacing ?? globalStyle.letterSpacing,
          wordSpacing: style.wordSpacing ?? globalStyle.wordSpacing,
          textAlign: style.textAlign ?? globalStyle.textAlign,
          color: style.color ?? normalizeColor(computed.color, globalStyle.color),
          fontWeight: style.fontWeight ?? computed.fontWeight ?? "400",
          fontStyle: style.fontStyle ?? computed.fontStyle ?? "normal",
        };
      };

      const updateStyleValueLabels = (effectiveStyle) => {
        if (styleFontSizeValue instanceof HTMLElement) {
          styleFontSizeValue.textContent = `${toNumber(effectiveStyle.fontSize, 0).toFixed(1)}px`;
        }
        if (styleLineHeightValue instanceof HTMLElement) {
          styleLineHeightValue.textContent = `${toNumber(effectiveStyle.lineHeight, 0).toFixed(2)}`;
        }
        if (styleLetterSpacingValue instanceof HTMLElement) {
          styleLetterSpacingValue.textContent = `${toNumber(effectiveStyle.letterSpacing, 0).toFixed(3)}em`;
        }
        if (styleWordSpacingValue instanceof HTMLElement) {
          styleWordSpacingValue.textContent = `${toNumber(effectiveStyle.wordSpacing, 0).toFixed(3)}em`;
        }
        const state = stateById.get(activeBlockId);
        if (styleZValue instanceof HTMLElement) {
          styleZValue.textContent = `${clamp(toNumber(state?.z, 30), styleRanges.z.min, styleRanges.z.max)}`;
        }
      };

      const setStyleControlsEnabled = (enabled) => {
        styleControls.forEach((control) => {
          control.disabled = !enabled;
        });
      };

      const syncStyleControls = () => {
        const block = blockById.get(activeBlockId);
        if (!block) return;

        const canEditStyle = block.styleEditable !== false;
        setStyleControlsEnabled(canEditStyle);

        if (!canEditStyle) return;
        const effectiveStyle = getEffectiveStyle(block);

        styleFont.value = findMatchingFontValue(styleFont, effectiveStyle.fontFamily) || effectiveStyle.fontFamily;
        styleSize.value = `${toNumber(effectiveStyle.fontSize, 23)}`;
        styleLineHeight.value = `${toNumber(effectiveStyle.lineHeight, 1.47)}`;
        styleLetterSpacing.value = `${toNumber(effectiveStyle.letterSpacing, 0)}`;
        styleWordSpacing.value = `${toNumber(effectiveStyle.wordSpacing, 0)}`;
        styleAlign.value = alignOptions.has(effectiveStyle.textAlign) ? effectiveStyle.textAlign : "left";
        styleColor.value = normalizeColor(effectiveStyle.color, fallbackColor);
        styleZ.value = `${clamp(toNumber(stateById.get(activeBlockId)?.z, 30), styleRanges.z.min, styleRanges.z.max)}`;
        styleBold.checked = isBoldValue(effectiveStyle.fontWeight);
        styleItalic.checked = isItalicValue(effectiveStyle.fontStyle);
        updateStyleValueLabels(effectiveStyle);
      };

      const serializePayload = () => ({
        version: contentVersion,
        page: namespace,
        updatedAt: new Date().toISOString(),
        blocks: blockEntries.map((block) => {
          const state = stateById.get(block.id) ?? {
            text: "",
            x: 0,
            y: 0,
            rotate: 0,
            hidden: false,
            w: block.resizable ? toNumber(block.defaultWidth, 340) : 0,
            z: 30,
            style: {},
          };
          return {
            id: block.id,
            ...(block.dynamic ? { dynamic: true, type: "rich-text", label: block.label ?? block.id } : {}),
            text: `${state.text ?? ""}`,
            x: toNumber(state.x, 0),
            y: toNumber(state.y, 0),
            rotate: toNumber(state.rotate, 0),
            hidden: Boolean(state.hidden),
            w: block.resizable ? clamp(toNumber(state.w, toNumber(block.defaultWidth, 340)), getBounds(block).minW, getBounds(block).maxW) : 0,
            z: clamp(toNumber(state.z, 30), styleRanges.z.min, styleRanges.z.max),
            style: sanitizeBlockStyle(state.style),
          };
        }),
      });

      const contentFingerprint = (payload) => {
        const stablePayload = { ...payload, updatedAt: "" };
        return JSON.stringify(stablePayload);
      };

      let lastContentFingerprint = "";

      const savePayload = (showFeedback = false) => {
        try {
          const payload = serializePayload();
          const nextFingerprint = contentFingerprint(payload);
          if (nextFingerprint === lastContentFingerprint) {
            if (showFeedback) setStatus("Contenuti salvati");
            return;
          }
          lastContentFingerprint = nextFingerprint;
          window.localStorage.setItem(storageKey, JSON.stringify(payload));
          if (showFeedback) setStatus("Contenuti salvati");
        } catch (error) {
          if (showFeedback) setStatus("Salvataggio contenuti non riuscito");
        }
      };

      let autoSaveContentTimerId = 0;
      const scheduleContentSave = () => {
        if (!autoSaveEnabled) return;
        window.clearTimeout(autoSaveContentTimerId);
        autoSaveContentTimerId = window.setTimeout(() => savePayload(false), 700);
      };

      window.addEventListener("style-editor:save-all", (event) => {
        const detail = event?.detail;
        if (!detail || typeof detail !== "object") return;
        if (detail.storageKey !== panel.dataset.storageKey) return;
        savePayload(true);
      });

      const isSupportedVersion = (value) => {
        if (value === undefined || value === null) return true;
        const parsed = Number(value);
        return supportedContentVersions.has(parsed);
      };

      const loadPayload = () => {
        let hasLoadedEntries = false;
        try {
          const raw = window.localStorage.getItem(storageKey);
          if (!raw) return false;
          const parsed = JSON.parse(raw);
          if (!parsed || typeof parsed !== "object") return false;
          if (!isSupportedVersion(parsed.version)) return false;
          if (parsed.page && parsed.page !== namespace) return false;
          if (!Array.isArray(parsed.blocks)) return false;

          parsed.blocks.forEach((entry) => {
            if (!entry || typeof entry !== "object") return;
            if (entry.dynamic !== true && entry.type !== "rich-text") return;
            if (typeof entry.id === "string" && blockById.has(entry.id)) return;
            createDynamicRichBlock(entry, false);
          });

          parsed.blocks.forEach((entry) => {
            if (!entry || typeof entry !== "object") return;
            if (typeof entry.id !== "string") return;
            const block = blockById.get(entry.id);
            if (!block) return;
            const state = stateById.get(entry.id);
            if (!state) return;

            if (typeof entry.text === "string") {
              if (block.richMode === "paragraphs") {
                const fallbackWithParagraphs = block.defaultText;
                const fallbackFlat = normalizeText(fallbackWithParagraphs);
                const incomingFlat = normalizeText(entry.text);
                const hasParagraphSeparators = entry.text.includes("\n\n");
                state.text =
                  !hasParagraphSeparators && incomingFlat === fallbackFlat
                    ? fallbackWithParagraphs
                    : entry.text;
              } else {
                state.text = entry.text;
              }
            }
            state.x = toNumber(entry.x, 0);
            state.y = toNumber(entry.y, 0);
            state.rotate = toNumber(entry.rotate, 0);
            state.hidden = Boolean(entry.hidden);
            if (block.resizable) {
              const bounds = getBounds(block);
              state.w = clamp(toNumber(entry.w, toNumber(block.defaultWidth, 340)), bounds.minW, bounds.maxW);
            }
            state.z = clamp(toNumber(entry.z, state.z ?? 30), styleRanges.z.min, styleRanges.z.max);
            if (entry.style && typeof entry.style === "object") {
              state.style = {
                ...state.style,
                ...sanitizeBlockStyle(entry.style),
              };
            }
            hasLoadedEntries = true;
          });
        } catch (error) {
          return false;
        }
        return hasLoadedEntries;
      };

      const updateHandlePosition = () => {
        const block = blockById.get(activeBlockId);
        if (!block) {
          dragHandle.classList.remove("is-visible");
          deleteHandle.classList.remove("is-visible");
          resizeHandle.classList.remove("is-visible");
          rotateHandle.classList.remove("is-visible");
          return;
        }
        const state = stateById.get(activeBlockId);
        if (state?.hidden) {
          dragHandle.classList.remove("is-visible");
          deleteHandle.classList.remove("is-visible");
          resizeHandle.classList.remove("is-visible");
          rotateHandle.classList.remove("is-visible");
          return;
        }

        const canDrag = editMode && block.transform !== "none" && (!block.desktopOnlyTransform || isDesktop());
        const canDelete = editMode && Boolean(block.deletable);
        const canResize = editMode && Boolean(block.resizable);
        const canRotate = editMode && block.transform !== "none" && (!block.desktopOnlyTransform || isDesktop());

        if (!canDrag) {
          dragHandle.classList.remove("is-visible");
        }
        if (!canDelete) {
          deleteHandle.classList.remove("is-visible");
        }
        if (!canResize) {
          resizeHandle.classList.remove("is-visible");
        }
        if (!canRotate) {
          rotateHandle.classList.remove("is-visible");
        }
        if (!canDrag && !canDelete && !canResize && !canRotate) return;

        const rect = block.element.getBoundingClientRect();
        if (rect.width <= 0 || rect.height <= 0) {
          dragHandle.classList.remove("is-visible");
          deleteHandle.classList.remove("is-visible");
          resizeHandle.classList.remove("is-visible");
          rotateHandle.classList.remove("is-visible");
          return;
        }

        if (canDrag) {
          dragHandle.classList.add("is-visible");
          dragHandle.style.left = `${Math.max(6, rect.left - 14)}px`;
          dragHandle.style.top = `${Math.max(6, rect.top + 8)}px`;
        }

        if (canDelete) {
          deleteHandle.classList.add("is-visible");
          deleteHandle.style.left = `${Math.max(6, rect.right - 14)}px`;
          deleteHandle.style.top = `${Math.max(6, rect.top + 8)}px`;
        }

        if (canResize) {
          resizeHandle.classList.add("is-visible");
          resizeHandle.style.left = `${clamp(Math.round(rect.right - 18), 10, Math.max(10, window.innerWidth - 34))}px`;
          resizeHandle.style.top = `${clamp(Math.round(rect.bottom - 18), 10, Math.max(10, window.innerHeight - 34))}px`;
        }

        if (canRotate) {
          rotateHandle.classList.add("is-visible");
          rotateHandle.style.left = `${clamp(Math.round(rect.left + rect.width / 2 - 14), 10, Math.max(10, window.innerWidth - 34))}px`;
          rotateHandle.style.top = `${Math.max(6, rect.top - 18)}px`;
        }
      };

      const updateTransformControls = () => {
        const block = blockById.get(activeBlockId);
        if (!block) return;
        const state = stateById.get(block.id);
        if (!state) return;

        const showTransform = block.transform !== "none" || Boolean(block.resizable);
        transformControls.classList.toggle("is-hidden", !showTransform);
        if (!showTransform) return;

        const bounds = getBounds(block);
        xRange.min = `${bounds.minX}`;
        xRange.max = `${bounds.maxX}`;
        xRange.step = "1";
        xRange.disabled = block.transform === "none";

        yRange.min = `${bounds.minY}`;
        yRange.max = `${bounds.maxY}`;
        yRange.step = "1";
        yRange.disabled = block.transform === "none";

        rotateRange.min = `${bounds.minRotate}`;
        rotateRange.max = `${bounds.maxRotate}`;
        rotateRange.step = "1";
        rotateRange.disabled = block.transform === "none";
        widthRange.min = `${bounds.minW}`;
        widthRange.max = `${bounds.maxW}`;
        const snapSettings = readSnapSettings();
        const snapStep = snapSettings.enabled ? `${snapSettings.size}` : "1";
        xRange.step = snapStep;
        yRange.step = snapStep;
        widthRange.step = snapStep;
        widthRange.disabled = !Boolean(block.resizable);

        xRange.value = `${toNumber(state.x, 0)}`;
        yRange.value = `${toNumber(state.y, 0)}`;
        rotateRange.value = `${toNumber(state.rotate, 0)}`;
        widthRange.value = `${toNumber(block.resizable ? state.w : bounds.minW, bounds.minW)}`;

        if (valueX instanceof HTMLElement) valueX.textContent = `${toNumber(state.x, 0)}px`;
        if (valueY instanceof HTMLElement) valueY.textContent = `${toNumber(state.y, 0)}px`;
        if (valueRotate instanceof HTMLElement) {
          valueRotate.textContent =
            block.transform !== "none" ? `${toNumber(state.rotate, 0)}°` : "N/A";
        }
        if (valueWidth instanceof HTMLElement) {
          valueWidth.textContent = block.resizable ? `${toNumber(state.w, bounds.minW)}px` : "N/A";
        }
      };

      const setActiveBlock = (blockId) => {
        if (!blockById.has(blockId)) return;
        activeBlockId = blockId;
        const activeBlock = blockById.get(activeBlockId);

        blockEntries.forEach((block) => {
          block.element.classList.toggle("content-editor-block--active", block.id === activeBlockId);
        });

        if (activeLabelNode instanceof HTMLElement) {
          activeLabelNode.textContent = `Stai modificando: ${activeBlock?.label ?? activeBlockId}`;
        }
        if (styleScopeNode instanceof HTMLElement) {
          styleScopeNode.textContent = `Le impostazioni qui sotto si applicano solo a: ${activeBlock?.label ?? activeBlockId}.`;
        }

        blockSelect.value = activeBlockId;
        const state = stateById.get(activeBlockId);
        textArea.value = state?.text ?? "";
        updateTransformControls();
        syncStyleControls();
        updateHandlePosition();
      };

      const deleteActiveBlock = () => {
        const block = blockById.get(activeBlockId);
        if (!block || !block.deletable) return false;
        if (block.dynamic) {
          const state = stateById.get(activeBlockId);
          if (!state) return false;
          state.hidden = true;
          applyBlockState(block);
          hideRichToolbar();
          scheduleContentSave();
          try {
            window.dispatchEvent(
              new CustomEvent("content-editor:delete", {
                detail: { blockId: activeBlockId, selector: block.selector },
              }),
            );
          } catch {}
          setStatus("Rich text box nascosto");
          return true;
        }
        const state = stateById.get(activeBlockId);
        if (!state) return false;
        state.hidden = true;
        applyBlockState(block);
        scheduleContentSave();
        try {
          window.dispatchEvent(
            new CustomEvent("content-editor:delete", {
              detail: { blockId: activeBlockId, selector: block.selector },
            }),
          );
        } catch {}
        setStatus("Blocco nascosto");
        return true;
      };

      deleteHandle.addEventListener("click", deleteActiveBlock);

      document.addEventListener("keydown", (event) => {
        if (!editMode || event.key !== "Delete") return;
        const active = document.activeElement;
        const target = event.target;
        const isRichTextEditing =
          (active instanceof HTMLElement && Boolean(active.closest("[contenteditable='true']"))) ||
          (target instanceof HTMLElement && Boolean(target.closest("[contenteditable='true']")));
        if (
          active instanceof HTMLInputElement ||
          active instanceof HTMLTextAreaElement ||
          active instanceof HTMLSelectElement ||
          isRichTextEditing ||
          richTextToolbar.contains(active)
        ) {
          return;
        }
        if (!blockById.get(activeBlockId)?.deletable) return;
        event.preventDefault();
        deleteActiveBlock();
      });

      const setEditMode = (enabled) => {
        editMode = enabled;
        editModeToggle.checked = enabled;
        document.body.classList.toggle("content-edit-mode", enabled);

        blockEntries.forEach((block) => {
          if (enabled && block.editable) {
            block.element.setAttribute("contenteditable", "true");
            block.element.classList.add("content-editor-editable");
          } else {
            block.element.removeAttribute("contenteditable");
            block.element.classList.remove("content-editor-editable");
          }
        });

        if (!enabled) {
          hideRichToolbar();
          blockEntries.forEach((block) => block.element.classList.remove("content-editor-block--active"));
        } else {
          setActiveBlock(activeBlockId);
        }

        setRichTextToolbarEnabled(enabled);
        updateHandlePosition();

        try {
          window.localStorage.setItem(editModeStorageKey, enabled ? "1" : "0");
        } catch (error) {
        }
      };

      const resetContent = () => {
        hideRichToolbar();
        blockEntries.forEach((block) => {
          if (block.dynamic) {
            const state = stateById.get(block.id);
            if (!state) return;
            state.hidden = true;
            applyBlockState(block);
            return;
          }

          block.element.innerHTML = block.defaultHtml;
          stateById.set(block.id, {
            text: extractBlockText(block) || block.defaultText,
            x: 0,
            y: 0,
            rotate: 0,
            hidden: false,
            w: block.resizable ? toNumber(block.defaultWidth, 340) : 0,
            z: toNumber(block.defaultZ, 30),
            style: { ...block.defaultStyle },
          });
          applyTransform(block);
          applyBlockStyle(block);
          block.element.hidden = false;
        });

        setActiveBlock(activeBlockId);
        savePayload(false);
        setStatus("Contenuti resettati");
      };

      const resetActiveBlockStyle = () => {
        const block = blockById.get(activeBlockId);
        if (!block) return;
        const state = stateById.get(activeBlockId);
        if (!state) return;
        state.style = { ...block.defaultStyle };
        applyBlockStyle(block);
        syncStyleControls();
        scheduleContentSave();
        setStatus("Stile blocco resettato");
      };

      const resetAllBlockStyles = () => {
        blockEntries.forEach((block) => {
          const state = stateById.get(block.id);
          if (!state) return;
          state.style = { ...block.defaultStyle };
          applyBlockStyle(block);
        });
        syncStyleControls();
        scheduleContentSave();
        setStatus("Stili contenuti resettati");
      };

      const importPayload = (payload) => {
        if (!payload || typeof payload !== "object") return false;
        if (!isSupportedVersion(payload.version)) {
          setStatus("Versione JSON non compatibile");
          return false;
        }
        if (payload.page && payload.page !== namespace) {
          setStatus("JSON non compatibile con questa pagina");
          return false;
        }
        if (!Array.isArray(payload.blocks)) {
          setStatus("JSON contenuti non valido");
          return false;
        }

        payload.blocks.forEach((entry) => {
          if (!entry || typeof entry !== "object") return;
          if (entry.dynamic !== true && entry.type !== "rich-text") return;
          if (typeof entry.id === "string" && blockById.has(entry.id)) return;
          createDynamicRichBlock(entry, false);
        });

        payload.blocks.forEach((entry) => {
          if (!entry || typeof entry !== "object") return;
          if (typeof entry.id !== "string") return;
          const block = blockById.get(entry.id);
          if (!block) return;
          const state = stateById.get(entry.id);
          if (!state) return;

          if (typeof entry.text === "string") {
            state.text = entry.text;
          }

          const bounds = getBounds(block);
          state.x = clamp(toNumber(entry.x, 0), bounds.minX, bounds.maxX);
          state.y = clamp(toNumber(entry.y, 0), bounds.minY, bounds.maxY);
          state.rotate = clamp(toNumber(entry.rotate, 0), bounds.minRotate, bounds.maxRotate);
          state.hidden = Boolean(entry.hidden);
          if (block.resizable) {
            state.w = clamp(toNumber(entry.w, toNumber(block.defaultWidth, 340)), bounds.minW, bounds.maxW);
          }
          state.z = clamp(toNumber(entry.z, state.z ?? 30), styleRanges.z.min, styleRanges.z.max);
          if (entry.style && typeof entry.style === "object") {
            state.style = {
              ...state.style,
              ...sanitizeBlockStyle(entry.style),
            };
          }
        });

        blockEntries.forEach((block) => applyBlockState(block));
        savePayload(false);
        setActiveBlock(activeBlockId);
        setStatus("Contenuti importati");
        return true;
      };

      const updateActiveStyle = (partialStyle) => {
        const block = blockById.get(activeBlockId);
        if (!block || block.styleEditable === false) return;
        const state = stateById.get(activeBlockId);
        if (!state) return;
        state.style = sanitizeBlockStyle({ ...state.style, ...partialStyle });
        applyBlockStyle(block);
        syncStyleControls();
        scheduleContentSave();
      };

      const updateActiveLayer = () => {
        const block = blockById.get(activeBlockId);
        const state = stateById.get(activeBlockId);
        if (!block || !state) return;
        state.z = clamp(toNumber(styleZ.value, 30), styleRanges.z.min, styleRanges.z.max);
        applyTransform(block);
        syncStyleControls();
        scheduleContentSave();
      };

      function bindBlockEvents(block) {
        if (!block || block.eventsBound) return;
        block.eventsBound = true;

        block.element.addEventListener("click", (event) => {
          if (editMode && event.target instanceof Element && event.target.closest("a")) event.preventDefault();
          setActiveBlock(block.id);
        });

        block.element.addEventListener("dblclick", (event) => {
          if (!block.editable) return;
          if (editMode && event.target instanceof Element && event.target.closest("a")) event.preventDefault();
          if (!editMode) setEditMode(true);
          setActiveBlock(block.id);
        });

        block.element.addEventListener("input", () => {
          if (!editMode || !block.editable) return;
          const text = extractBlockText(block);
          const state = stateById.get(block.id);
          if (!state) return;
          state.text = text;
          if (activeBlockId === block.id) textArea.value = text;
          scheduleContentSave();
        });

        block.element.addEventListener("mouseup", () => {
          window.setTimeout(showRichToolbarForSelection, 0);
        });

        block.element.addEventListener("keyup", () => {
          showRichToolbarForSelection();
        });

        block.element.addEventListener("paste", (event) => {
          if (!editMode || !block.editable) return;
          if (block.richMode === "html") return;
          event.preventDefault();
          const clipboard = event.clipboardData?.getData("text/plain") ?? "";
          document.execCommand("insertText", false, clipboard);
        });
      }

      blockEntries.forEach((block) => bindBlockEvents(block));

      document.addEventListener("selectionchange", () => {
        if (richToolbarPointerActive || richTextToolbar.contains(document.activeElement)) return;
        window.setTimeout(showRichToolbarForSelection, 0);
      });

      textArea.addEventListener("input", () => {
        const block = blockById.get(activeBlockId);
        if (!block) return;
        const state = stateById.get(block.id);
        if (!state) return;
        state.text = textArea.value;
        writeBlockText(block, textArea.value);
        hideRichToolbar();
        scheduleContentSave();
      });

      const applyTransformFromControls = () => {
        const block = blockById.get(activeBlockId);
        if (!block) return;
        const state = stateById.get(block.id);
        if (!state) return;

        const bounds = getBounds(block);
        const snapSettings = readSnapSettings();
        if (block.transform !== "none") {
          state.x = snapClamped(toNumber(xRange.value, 0), bounds.minX, bounds.maxX, snapSettings);
          state.y = snapClamped(toNumber(yRange.value, 0), bounds.minY, bounds.maxY, snapSettings);
        } else {
          state.x = 0;
          state.y = 0;
        }
        if (block.transform !== "none") {
          state.rotate = clamp(toNumber(rotateRange.value, 0), bounds.minRotate, bounds.maxRotate);
        } else {
          state.rotate = 0;
        }
        if (block.resizable) {
          state.w = snapClamped(toNumber(widthRange.value, toNumber(block.defaultWidth, 340)), bounds.minW, bounds.maxW, snapSettings);
        } else {
          state.w = 0;
        }

        applyTransform(block);
        updateTransformControls();
        updateHandlePosition();
        scheduleContentSave();
      };

      xRange.addEventListener("input", applyTransformFromControls);
      yRange.addEventListener("input", applyTransformFromControls);
      rotateRange.addEventListener("input", applyTransformFromControls);
      widthRange.addEventListener("input", applyTransformFromControls);

      styleFont.addEventListener("change", () => updateActiveStyle({ fontFamily: styleFont.value }));
      styleSize.addEventListener("input", () =>
        updateActiveStyle({
          fontSize: clamp(
            toNumber(styleSize.value, styleRanges.fontSize.min),
            styleRanges.fontSize.min,
            styleRanges.fontSize.max,
          ),
        }),
      );
      styleLineHeight.addEventListener("input", () =>
        updateActiveStyle({
          lineHeight: clamp(
            toNumber(styleLineHeight.value, styleRanges.lineHeight.min),
            styleRanges.lineHeight.min,
            styleRanges.lineHeight.max,
          ),
        }),
      );
      styleLetterSpacing.addEventListener("input", () =>
        updateActiveStyle({
          letterSpacing: clamp(
            toNumber(styleLetterSpacing.value, 0),
            styleRanges.letterSpacing.min,
            styleRanges.letterSpacing.max,
          ),
        }),
      );
      styleWordSpacing.addEventListener("input", () =>
        updateActiveStyle({
          wordSpacing: clamp(
            toNumber(styleWordSpacing.value, 0),
            styleRanges.wordSpacing.min,
            styleRanges.wordSpacing.max,
          ),
        }),
      );
      styleAlign.addEventListener("change", () =>
        updateActiveStyle({
          textAlign: alignOptions.has(styleAlign.value) ? styleAlign.value : "left",
        }),
      );
      styleColor.addEventListener("input", () =>
        updateActiveStyle({
          color: normalizeColor(styleColor.value, fallbackColor),
        }),
      );
      styleZ.addEventListener("input", updateActiveLayer);
      styleBold.addEventListener("change", () =>
        updateActiveStyle({
          fontWeight: styleBold.checked ? "700" : "400",
        }),
      );
      styleItalic.addEventListener("change", () =>
        updateActiveStyle({
          fontStyle: styleItalic.checked ? "italic" : "normal",
        }),
      );

      blockSelect.addEventListener("change", () => {
        setActiveBlock(blockSelect.value);
      });

      editModeToggle.addEventListener("change", () => {
        setEditMode(editModeToggle.checked);
      });

      addRichBoxButton?.addEventListener("click", () => {
        const bounds = {
          minX: -200,
          maxX: Math.max(1600, document.documentElement.scrollWidth + 600),
          minY: -200,
          maxY: Math.max(1600, document.documentElement.scrollHeight + 800),
        };
        const block = createDynamicRichBlock(
          {
            x: snapClamped(72 + blockEntries.filter((entry) => entry.dynamic).length * 18, bounds.minX, bounds.maxX),
            y: snapClamped(window.scrollY + 180 + blockEntries.filter((entry) => entry.dynamic).length * 18, bounds.minY, bounds.maxY),
            text: "<p>Nuovo rich text box</p>",
          },
          true,
        );
        if (block) {
          scheduleContentSave();
          setStatus("Rich text box aggiunto");
        }
      });

      saveButton?.addEventListener("click", () => savePayload(true));
      resetButton?.addEventListener("click", resetContent);
      resetStyleBlockButton?.addEventListener("click", resetActiveBlockStyle);
      resetStyleAllButton?.addEventListener("click", resetAllBlockStyles);
      showAllButton?.addEventListener("click", () => {
        blockEntries.forEach((block) => {
          const state = stateById.get(block.id);
          if (!state) return;
          state.hidden = false;
          applyBlockState(block);
        });
        scheduleContentSave();
        setStatus("Blocchi ripristinati");
        setActiveBlock(activeBlockId);
      });

      exportButton?.addEventListener("click", () => {
        try {
          const payload = serializePayload();
          const blob = new Blob([JSON.stringify(payload, null, 2)], {
            type: "application/json",
          });
          const url = URL.createObjectURL(blob);
          const link = document.createElement("a");
          link.href = url;
          link.download = `${namespace}-content.json`;
          document.body.appendChild(link);
          link.click();
          link.remove();
          URL.revokeObjectURL(url);
          setStatus("JSON esportato");
        } catch (error) {
          setStatus("Export non riuscito");
        }
      });

      importButton?.addEventListener("click", () => {
        if (!(importInput instanceof HTMLInputElement)) return;
        importInput.click();
      });

      importInput?.addEventListener("change", async () => {
        if (!(importInput instanceof HTMLInputElement)) return;
        const [file] = importInput.files ?? [];
        if (!file) return;

        try {
          const text = await file.text();
          const payload = JSON.parse(text);
          importPayload(payload);
        } catch (error) {
          setStatus("Import non riuscito");
        } finally {
          importInput.value = "";
        }
      });

      dragHandle.addEventListener("pointerdown", (event) => {
        const block = blockById.get(activeBlockId);
        if (!block || !editMode || block.transform === "none") return;
        if (block.desktopOnlyTransform && !isDesktop()) return;

        event.preventDefault();

        const state = stateById.get(block.id);
        if (!state) return;
        const bounds = getBounds(block);
        const startPointerX = event.clientX;
        const startPointerY = event.clientY;
        const startX = toNumber(state.x, 0);
        const startY = toNumber(state.y, 0);

        const onMove = (moveEvent) => {
          const deltaX = moveEvent.clientX - startPointerX;
          const deltaY = moveEvent.clientY - startPointerY;
          const snapSettings = readSnapSettings();
          state.x = snapClamped(startX + deltaX, bounds.minX, bounds.maxX, snapSettings, moveEvent);
          state.y = snapClamped(startY + deltaY, bounds.minY, bounds.maxY, snapSettings, moveEvent);
          applyTransform(block);
          try {
            window.dispatchEvent(
              new CustomEvent("content-editor:transform", {
                detail: { namespace, blockId: block.id, element: block.element, clientY: moveEvent.clientY },
              }),
            );
          } catch {}
          updateTransformControls();
          updateHandlePosition();
        };

        const onUp = () => {
          window.removeEventListener("pointermove", onMove);
          window.removeEventListener("pointerup", onUp);
          savePayload(false);
        };

        window.addEventListener("pointermove", onMove);
        window.addEventListener("pointerup", onUp);
      });

      resizeHandle.addEventListener("pointerdown", (event) => {
        const block = blockById.get(activeBlockId);
        if (!block || !editMode || !block.resizable) return;

        event.preventDefault();

        const state = stateById.get(block.id);
        if (!state) return;
        const bounds = getBounds(block);
        const startPointerX = event.clientX;
        const startWidth = toNumber(state.w, toNumber(block.defaultWidth, 340));

        const onMove = (moveEvent) => {
          const delta = moveEvent.clientX - startPointerX;
          state.w = snapClamped(startWidth + delta, bounds.minW, bounds.maxW, readSnapSettings(), moveEvent);
          applyTransform(block);
          updateTransformControls();
          updateHandlePosition();
        };

        const onUp = () => {
          window.removeEventListener("pointermove", onMove);
          window.removeEventListener("pointerup", onUp);
          window.removeEventListener("pointercancel", onUp);
          savePayload(false);
        };

        window.addEventListener("pointermove", onMove);
        window.addEventListener("pointerup", onUp);
        window.addEventListener("pointercancel", onUp);
      });

      rotateHandle.addEventListener("pointerdown", (event) => {
        const block = blockById.get(activeBlockId);
        if (!block || !editMode || block.transform === "none") return;
        if (block.desktopOnlyTransform && !isDesktop()) return;

        event.preventDefault();

        const state = stateById.get(block.id);
        if (!state) return;
        const bounds = getBounds(block);
        const rect = block.element.getBoundingClientRect();
        const startAngle = getPointerAngle(event, rect);
        const startRotate = toNumber(state.rotate, 0);

        const onMove = (moveEvent) => {
          const nextAngle = getPointerAngle(moveEvent, rect);
          state.rotate = clamp(Math.round(startRotate + nextAngle - startAngle), bounds.minRotate, bounds.maxRotate);
          applyTransform(block);
          updateTransformControls();
          updateHandlePosition();
        };

        const onUp = () => {
          window.removeEventListener("pointermove", onMove);
          window.removeEventListener("pointerup", onUp);
          window.removeEventListener("pointercancel", onUp);
          savePayload(false);
        };

        window.addEventListener("pointermove", onMove);
        window.addEventListener("pointerup", onUp);
        window.addEventListener("pointercancel", onUp);
      });

      window.addEventListener("resize", updateHandlePosition);
      window.addEventListener("scroll", updateHandlePosition, { passive: true });

      try {
        const storedEditMode = window.localStorage.getItem(editModeStorageKey);
        if (storedEditMode === "0") editMode = false;
        if (storedEditMode === "1") editMode = true;
      } catch (error) {
      }

      const hasStoredContent = loadPayload();
      syncSnapControls(readSnapSettings());
      blockEntries.forEach((block) => {
        if (hasStoredContent) {
          applyBlockState(block);
          return;
        }
        applyTransform(block);
        applyBlockStyle(block);
      });

      setActiveBlock(activeBlockId);
      setEditMode(editMode);
      if (styleAdvanced instanceof HTMLDetailsElement) styleAdvanced.open = false;
      lastContentFingerprint = contentFingerprint(serializePayload());
    });

    try {
      window.dispatchEvent(new CustomEvent("content-editor:ready"));
    } catch {}
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initContentEditors, { once: true });
  } else {
    initContentEditors();
  }
</script>
