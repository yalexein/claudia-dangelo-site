---
import "../styles/landing.css";
import SitePageHeader from "../components/SitePageHeader.astro";
import "../styles/site-page-header.css";

const { title = "Sito personale", pageNameIt, pageNameEn = pageNameIt, pageHeaderEditKey = "page" } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}site-settings.css?v=1`} />
    <script is:inline src={`${base}site-locale.js?v=1`}></script>
  </head>
  <body>
    {pageNameIt ? <SitePageHeader pageNameIt={pageNameIt} pageNameEn={pageNameEn} editKey={pageHeaderEditKey} /> : null}
    <main class="container">
      <slot />
    </main>
  </body>
</html>
