---
import SitePageHeader from "../components/SitePageHeader.astro";
import "../styles/site-page-header.css";

const {
  title = "Bio — Claudia D'Angelo",
  descriptionIt = "Biografia di Claudia D'Angelo: scrittrice, autrice di Le forze e artista del collage, tra Napoli e Dublino.",
  descriptionEn = "Biography of Claudia D'Angelo: writer, author of Le forze and collage artist, between Naples and Dublin.",
  customizationPage = "bio",
  pageNameIt,
  pageNameEn = pageNameIt,
  pageHeaderEditKey = customizationPage,
} = Astro.props;
const base = import.meta.env.BASE_URL;
const webFontsHref =
  "https://fonts.googleapis.com/css2?family=Bodoni+Moda:wght@400;600;700&family=IBM+Plex+Mono:wght@400;600;700&display=swap";
---

<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta
      name="description"
      content={descriptionIt}
      data-locale-content-it={descriptionIt}
      data-locale-content-en={descriptionEn}
    />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content="Claudia D'Angelo" />
    <meta property="og:title" content={title} />
    <meta
      property="og:description"
      content={descriptionIt}
      data-locale-content-it={descriptionIt}
      data-locale-content-en={descriptionEn}
    />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:locale:alternate" content="en_US" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta
      name="twitter:description"
      content={descriptionIt}
      data-locale-content-it={descriptionIt}
      data-locale-content-en={descriptionEn}
    />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="stylesheet" href={`${base}site-settings.css?v=1`} />
    <script is:inline src={`${base}site-locale.js?v=2`}></script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={webFontsHref} />
    <script is:inline define:vars={{ customizationPage }}>window.ClaudiaCustomizationPage = customizationPage;</script>
    <script is:inline src={`${base}contact-customizer.js?v=20260809-2`}></script>
  </head>
  <body>
    {pageNameIt ? <SitePageHeader pageNameIt={pageNameIt} pageNameEn={pageNameEn} editKey={pageHeaderEditKey} /> : null}
    <slot />
  </body>
</html>
