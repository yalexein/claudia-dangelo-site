      const parseRichTextShadow = (value) => {
        const raw = `${value ?? ""}`.trim();
        const fallback = { enabled: false, color: "#000000", thickness: 6, length: 4 };
        if (!raw || raw === "none") return fallback;

        const colorMatch = raw.match(/rgba?\([^)]+\)|#[0-9a-f]{3,8}\b|hsla?\([^)]+\)|\b[a-z]+\b/i);
        const withoutColor = colorMatch ? raw.replace(colorMatch[0], "") : raw;
        const numbers = Array.from(withoutColor.matchAll(/-?\d+(\.\d+)?px/g)).map((match) =>
