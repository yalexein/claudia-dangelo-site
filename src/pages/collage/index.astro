---
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="it" data-visit-theme="day">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Collage di collage interattivo di Claudia D'Angelo." />
    <meta name="theme-color" content="#f7f5ef" />
    <title>Collage — Claudia D'Angelo</title>
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <script is:inline>
      (() => {
        const applyVisitTheme = () => {
          const requestedTheme = new URLSearchParams(window.location.search).get("theme");
          const theme = requestedTheme === "day" || requestedTheme === "night"
            ? requestedTheme
            : (new Date().getHours() >= 20 || new Date().getHours() < 7 ? "night" : "day");
          document.documentElement.dataset.visitTheme = theme;
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "night" ? "#000000" : "#f7f5ef");
        };
        applyVisitTheme();
        window.setInterval(applyVisitTheme, 60_000);
      })();
    </script>
    <link rel="stylesheet" href={`${base}collage-poster-mockups/style.css?v=9`} />
  </head>
  <body class="composition-page">
    <nav class="composition-nav" aria-label="Navigazione Collage" data-contact-edit="collage-navigation">
      <a href={base} data-contact-edit="collage-home-link">← home</a>
      <span data-contact-edit="collage-nav-title">collage di collage</span>
      <span aria-hidden="true"></span>
    </nav>

    <main class="contact-public composition" aria-label="Collage di collage di Claudia D'Angelo" data-contact-edit="collage-stage">
      <div class="composition-word" aria-label="Collage" data-contact-edit="collage-word">
        <span class="composition-letter composition-letter--c" style="--dx:7%;--dy:50%;--mx:50%;--my:7%;--lz:66" data-contact-edit="collage-letter-c">C</span>
        <span class="composition-letter composition-letter--o is-outline is-emphasis" style="--dx:22%;--dy:48%;--mx:50%;--my:21%;--lz:66" data-contact-edit="collage-letter-o">O</span>
        <span class="composition-letter composition-letter--l1 is-emphasis" style="--dx:35%;--dy:52%;--mx:50%;--my:35%;--lz:66" data-contact-edit="collage-letter-l-1">L</span>
        <span class="composition-letter composition-letter--l2 is-outline is-emphasis" style="--dx:49%;--dy:47%;--mx:50%;--my:49%;--lz:66" data-contact-edit="collage-letter-l-2">L</span>
        <span class="composition-letter composition-letter--a" style="--dx:63%;--dy:51%;--mx:50%;--my:63%;--lz:25" data-contact-edit="collage-letter-a">A</span>
        <span class="composition-letter composition-letter--g is-outline is-emphasis" style="--dx:78%;--dy:48%;--mx:50%;--my:77%;--lz:66" data-contact-edit="collage-letter-g">G</span>
        <span class="composition-letter composition-letter--e is-emphasis" style="--dx:92%;--dy:52%;--mx:50%;--my:91%;--lz:66" data-contact-edit="collage-letter-e">E</span>
      </div>

      <div class="composition-images" data-composition-images data-contact-edit="collage-images"></div>

      <p class="composition-note composition-note--top" data-contact-edit="collage-note-top">24 opere · ritagli · sovrapposizioni</p>
      <p class="composition-note composition-note--bottom" data-contact-edit="collage-note-bottom">clicca un collage per aprire l’originale</p>
      <p class="composition-signature" data-contact-edit="collage-signature">CLAUDIA D’ANGELO<br />2022—2026</p>
    </main>

    <div class="composition-lightbox" data-lightbox hidden aria-hidden="true" role="dialog" aria-modal="true" aria-label="Opera ingrandita">
      <button type="button" data-lightbox-close aria-label="Chiudi">×</button>
      <img data-lightbox-image alt="" />
    </div>

    <script is:inline src={`${base}collage-poster-mockups/mockup.js?v=9`}></script>
    <script is:inline>window.ClaudiaCustomizationPage = "collage";</script>
    <script is:inline src={`${base}contact-customizer.js?v=7`}></script>
  </body>
</html>
