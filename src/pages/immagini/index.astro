          </label>
          <div class="image-board-game-actions">
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-input-reset>
              Reset input
            </button>
          </div>
          <p class="image-board-game-hint" data-uccelli-game-input-status>
            Clicca un tasto e premi la nuova scorciatoia.
          </p>
        </section>

        <section class="image-board-game-panel__section" aria-label="Spawn player 2D">
          <h3>Spawn player</h3>
          <div class="image-board-game-actions">
            <button class="image-board-button image-board-button--secondary" type="button" aria-pressed="false" data-uccelli-game-spawn-pick>
              Piazza spawn
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-spawn-from-player>
              Da player
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-spawn-clear disabled>
              Cancella spawn
            </button>
          </div>
          <p class="image-board-game-hint" data-uccelli-game-spawn-status>
            Imposta il punto piedi dove appare il player quando parte la stanza.
          </p>
        </section>

        <section class="image-board-game-panel__section image-board-game-panel__section--wide" aria-label="Zona camminabile 2D">
          <h3>Zona camminabile</h3>
          <label class="image-board-checkbox-control">
            <input type="checkbox" data-uccelli-game-walk-enabled />
            <span>Limita movimento alla zona</span>
          </label>
          <div class="image-board-game-actions">
            <button class="image-board-button image-board-button--secondary" type="button" aria-pressed="false" data-uccelli-game-walk-draw>
              Disegna zona
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-walk-close disabled>
              Chiudi zona
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-walk-delete-point disabled>
              Elimina punto
            </button>
            <button class="image-board-button image-board-button--secondary" type="button" data-uccelli-game-walk-clear>
              Cancella zona
            </button>
          </div>
          <p class="image-board-game-hint" data-uccelli-game-walk-status>
            Clicca nel canvas per aggiungere punti. Con almeno 3 punti, la preview usa l'area come pavimento.
          </p>
        </section>
      </div>
    </aside>

    <input type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" multiple hidden data-uccelli-image-upload-input />
    <input type="file" accept="image/png,image/jpeg,.png,.jpg,.jpeg" multiple hidden data-uccelli-sprite-upload-input />
    <input type="file" accept="application/json,.json" hidden data-uccelli-image-import-data-input />
    <button class="image-board-editor-return" type="button" data-image-board-editor-mode-btn>
      Editor
    </button>
  </main>

  <script is:inline>
    window.dispatchEvent(new CustomEvent("content-editor:ready"));
  </script>
  <script is:inline src={`${base}image-canvas-editor/image-canvas-core.js?v=1`}></script>
  <script is:inline src={`${base}image-canvas-editor/public-page-exporter.js?v=3`}></script>
  <script is:inline src={`${base}shared-advanced-editor.js?v=24`}></script>
</BioLayout>
